# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Mapbox (Required for maps)
# Get from: https://account.mapbox.com/access-tokens/
PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_token_here"

# Resend (Required for email notifications)
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_key_here"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Twilio (Optional - for SMS notifications)
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_FROM_NUMBER="+1234567890"

# Upstash Redis (Optional - for rate limiting)
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token_here"

# PostHog Analytics (Optional)
# Get from: https://posthog.com/
PUBLIC_POSTHOG_KEY="phc_your_posthog_key"
PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Cron Job Authentication
CRON_SECRET="your-random-secret-here"

# Email sender address (used by email sending code)
EMAIL_FROM="hello@autism.place"

# Public site URL
PUBLIC_SITE_URL="https://autism.place"
