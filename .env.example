# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE="your-service-role-key-here"

# Mapbox
MAPBOX_TOKEN="pk.your-mapbox-token-here"

# Email (Resend)
RESEND_API_KEY="re_your-resend-key-here"
EMAIL_FROM="hello@findabacare.com"

# SMS (Twilio)
TWILIO_ACCOUNT_SID="ACxxxxxxxx"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_FROM_NUMBER="+15551234567"

# Analytics (PostHog)
POSTHOG_KEY="phc_your-posthog-key"
POSTHOG_HOST="https://us.i.posthog.com"

# Admin (temporary basic auth)
ADMIN_BASIC_USER="admin"
ADMIN_BASIC_PASS="changeme123"

# Cron token
CRON_TOKEN="random-secure-string-here"

# Google Places API (for venue fetching)
GOOGLE_MAPS_API_KEY="your-google-api-key"

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"
