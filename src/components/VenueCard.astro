---
import { goNow } from '../lib/goNow';
import { timeAgo } from '../lib/utils';
import VenueIconBadges from './VenueIconBadges';
import FavoriteButton from './FavoriteButton';

interface Props {
  venue: {
    id: string;
    name: string;
    slug?: string;
    address?: string;
    type?: string;
    amenities?: any;
    triggers?: any;
    sensory_hours?: any[];
    last_verified?: string;
    meter?: string;
    photo_keys?: string[];
    google_rating?: number;
    verification_status?: string;
    favorite_count?: number;
  };
}

const { venue } = Astro.props;
const meter = venue.meter || goNow(venue.type);

// Meter color classes
const meterColors = {
  'Quiet': 'bg-green-100 text-green-800 border-green-200',
  'Moderate': 'bg-yellow-100 text-yellow-800 border-yellow-200',
  'Busy': 'bg-red-100 text-red-800 border-red-200',
};

const meterClass = meterColors[meter as keyof typeof meterColors] || meterColors.Moderate;

// Convert photo URL to full Supabase Storage URL if it's a relative path
const getPhotoUrl = (photoKey: string | null | undefined): string => {
  if (!photoKey) return '/placeholder-venue.svg';

  // If it's already a full URL (starts with http/https), return as-is
  if (photoKey.startsWith('http://') || photoKey.startsWith('https://')) {
    return photoKey;
  }

  // If it's a relative path starting with /venue-photos/, convert to Supabase Storage URL
  if (photoKey.startsWith('/venue-photos/')) {
    const filename = photoKey.replace('/venue-photos/', '');
    return `https://gvfkyfzukwnjomksuvaq.supabase.co/storage/v1/object/public/venue-photos/${filename}`;
  }

  // Otherwise, assume it's a relative public path
  return photoKey;
};

const featuredImage = venue.photo_keys && venue.photo_keys.length > 0
  ? getPhotoUrl(venue.photo_keys[0])
  : '/placeholder-venue.svg';
---

<article
  class="group relative bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-gray-300 hover:shadow-lg transition-all duration-200 venue-card"
  data-venue={JSON.stringify({
    id: venue.id,
    name: venue.name,
    type: venue.type,
    amenities: venue.amenities || {},
    sensory_hours: venue.sensory_hours,
    meter: meter,
    last_verified: venue.last_verified,
    photo_keys: venue.photo_keys,
    google_rating: venue.google_rating,
    verification_status: venue.verification_status
  })}
>
  <!-- Featured Image -->
  <a href={`/venue/${venue.slug || venue.id}`} class="block">
    <div class="aspect-video relative overflow-hidden bg-gray-50">
      <img
        src={featuredImage}
        alt={venue.name}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
      <div class="absolute top-3 right-3">
        <span class={`px-3 py-1.5 text-xs font-medium rounded-full border ${meterClass}`}>
          {meter}
        </span>
      </div>
      <div class="absolute top-3 left-3">
        <FavoriteButton
          venueId={venue.id}
          venueName={venue.name}
          initialFavoriteCount={venue.favorite_count || 0}
          size="sm"
          showCount={false}
          client:load
        />
      </div>
    </div>
  </a>

  <div class="p-5">
    <div class="mb-3">
      <h3 class="text-lg font-semibold text-gray-900 group-hover:text-black transition-colors">
        {venue.name}
      </h3>
      {venue.address && (
        <p class="text-sm text-gray-600 mt-1 line-clamp-1">
          {venue.address}
        </p>
      )}
    </div>

  <!-- Icon Badges (displays actual data from database) -->
  <div class="mb-3">
    <VenueIconBadges
      venue={{
        type: venue.type || 'other',
        meter: meter,
        amenities: venue.amenities || {},
        triggers: venue.triggers || {},
        sensory_hours: venue.sensory_hours || []
      }}
      size="sm"
      showLabels={true}
      client:idle
    />
  </div>

  <!-- Last verified -->
  {venue.last_verified && (
    <p class="text-xs text-gray-500 mb-3">
      Last verified {timeAgo(venue.last_verified)}
    </p>
  )}

  <!-- View details link -->
  <a
    href={`/venue/${venue.slug || venue.id}`}
    class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-700 transition-colors"
  >
    View details
    <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </a>
  </div>
</article>
