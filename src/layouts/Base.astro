---
import AuthButton from '../components/AuthButton';
import { createClient } from '@supabase/supabase-js';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
}

const {
  title = 'autism.place - Find autism-friendly places near you',
  description = 'Discover autism-friendly venues with quiet hours, visual guides, and sensory accommodations. Parent-verified places across 40+ major US cities.',
  ogImage = '/Stock Images/AutismVenue.jpg',
  ogImageAlt = 'Autism-friendly venue with sensory accommodations',
  canonical
} = Astro.props;

const url = canonical || Astro.url.pathname;
const fullUrl = `https://autism.place${url}`;
const fullOgImage = new URL(ogImage, Astro.url.origin).href;

// Fetch cities dynamically for navigation
const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL!,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY!
);

const { data: cities } = await supabase
  .from('cities')
  .select('id, name, slug, state, priority_tier')
  .eq('status', 'active')
  .order('priority_tier', { ascending: true })
  .order('population', { ascending: false });

// Top 6 cities for header navigation
const topCities = (cities || []).slice(0, 6);

// Group all cities by state for footer
const citiesByState = (cities || []).reduce((acc, city) => {
  if (!acc[city.state]) {
    acc[city.state] = [];
  }
  acc[city.state].push(city);
  return acc;
}, {} as Record<string, typeof cities>);

// Sort states alphabetically
const sortedStates = Object.keys(citiesByState).sort();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#3B82F6" />

    <!-- Canonical URL -->
    <link rel="canonical" href={fullUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="autism.place" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={fullUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullOgImage} />
    <meta property="twitter:image:alt" content={ogImageAlt} />

    <!-- Google Maps API -->
    <script src={`https://maps.googleapis.com/maps/api/js?key=${import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || import.meta.env.GOOGLE_MAPS_API_KEY}&libraries=places`}></script>

    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white text-gray-900">
    <header class="border-b border-gray-200 bg-white sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <!-- Logo -->
          <div class="flex items-center">
            <a href="/" class="flex items-center gap-2 text-xl font-bold text-gray-900 hover:text-gray-700 transition-colors group">
              <img src="/Icon/AdobeStock_64544759.svg" alt="autism.place Logo" class="w-10 h-10 transition-transform group-hover:scale-110" />
              <span>autism.place</span>
            </a>
          </div>

          <!-- Navigation -->
          <nav class="hidden md:flex items-center space-x-8">
            <a href="/cities" class="text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors">
              Browse Cities
            </a>
            <a href="/about" class="text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors">
              About
            </a>
          </nav>

          <!-- Auth (desktop only) -->
          <div class="hidden md:flex items-center space-x-4">
            <div id="auth-container">
              <AuthButton client:load />
            </div>
          </div>

          <!-- Mobile menu button -->
          <div class="md:hidden">
            <button id="mobile-menu-button" class="p-2 rounded-md text-gray-700 hover:text-gray-900 hover:bg-gray-100" aria-label="Toggle menu">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200">
        <div class="px-4 pt-2 pb-3 space-y-1">
          <a href="/cities" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50">
            Browse Cities
          </a>
          <a href="/about" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50">
            About
          </a>
          <div class="px-3 py-2">
            <div id="auth-container-mobile">
              <AuthButton client:load />
            </div>
          </div>
        </div>
      </div>
    </header>

    <main class="min-h-[calc(100vh-4rem)]">
      <slot />
    </main>

    <footer class="border-t border-gray-200 bg-gray-50 mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <!-- Top Section -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
          <div>
            <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider">About</h3>
            <p class="mt-4 text-sm text-gray-600">
              autism.place helps families find autism-friendly venues across 40+ major US cities.
            </p>
          </div>

          <div>
            <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider">Top Cities</h3>
            <ul class="mt-4 space-y-2">
              {topCities.slice(0, 6).map(city => (
                <li>
                  <a
                    href={`/${city.state.toLowerCase()}/${city.slug}`}
                    class="text-sm text-gray-600 hover:text-gray-900"
                  >
                    {city.name}, {city.state}
                  </a>
                </li>
              ))}
              <li>
                <a href="/cities" class="text-sm text-blue-600 hover:text-blue-700 font-medium">
                  View all cities →
                </a>
              </li>
            </ul>
          </div>

          <div>
            <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider">Resources</h3>
            <ul class="mt-4 space-y-2">
              <li><a href="/about" class="text-sm text-gray-600 hover:text-gray-900">About Us</a></li>
              <li><a href="/privacy" class="text-sm text-gray-600 hover:text-gray-900">Privacy Policy</a></li>
              <li><a href="/terms" class="text-sm text-gray-600 hover:text-gray-900">Terms of Service</a></li>
            </ul>
          </div>

          <div>
            <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider">Contact</h3>
            <p class="mt-4 text-sm text-gray-600">
              Email: <a href="mailto:hello@autism.place" class="hover:text-gray-900">hello@autism.place</a>
            </p>
          </div>
        </div>

        <!-- Cities by State Section -->
        <div class="border-t border-gray-200 pt-12">
          <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-6">Browse by State</h3>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
            {sortedStates.map(state => (
              <div>
                <h4 class="text-xs font-semibold text-gray-900 uppercase tracking-wider mb-2">{state}</h4>
                <ul class="space-y-1">
                  {citiesByState[state].slice(0, 5).map(city => (
                    <li>
                      <a
                        href={`/${city.state.toLowerCase()}/${city.slug}`}
                        class="text-xs text-gray-600 hover:text-gray-900"
                      >
                        {city.name}
                      </a>
                    </li>
                  ))}
                  {citiesByState[state].length > 5 && (
                    <li>
                      <a
                        href={`/${state.toLowerCase()}`}
                        class="text-xs text-blue-600 hover:text-blue-700"
                      >
                        +{citiesByState[state].length - 5} more
                      </a>
                    </li>
                  )}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-8 pt-8 border-t border-gray-200">
          <p class="text-sm text-gray-500 text-center">
            © 2025 autism.place. All rights reserved. <a href="https://enrizhulati.com" target="_blank" rel="noopener noreferrer" class="hover:text-gray-700 transition-colors">Made in Texas</a>
          </p>
        </div>
      </div>
    </footer>

    <script>
      // Mobile menu toggle
      const mobileMenuButton = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');

      mobileMenuButton?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
