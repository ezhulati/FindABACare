---
import Base from '../layouts/Base.astro';
import { createClient } from '@supabase/supabase-js';

// Get search parameters
const url = new URL(Astro.request.url);
const lat = parseFloat(url.searchParams.get('lat') || '0');
const lng = parseFloat(url.searchParams.get('lng') || '0');
const address = url.searchParams.get('address') || '';
const radius = parseInt(url.searchParams.get('radius') || '10'); // miles

if (!lat || !lng) {
  return Astro.redirect('/');
}

// Initialize Supabase
const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL!,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY!
);

// Calculate bounding box for efficient querying
// 1 mile ≈ 0.0145 degrees latitude, 0.0145/cos(lat) degrees longitude
const latDelta = (radius / 69.0); // 69 miles per degree latitude
const lngDelta = (radius / (69.0 * Math.cos(lat * Math.PI / 180)));

const minLat = lat - latDelta;
const maxLat = lat + latDelta;
const minLng = lng - lngDelta;
const maxLng = lng + lngDelta;

// Fetch venues within bounding box
const { data: venues, error } = await supabase
  .from('venues')
  .select('*')
  .gte('lat', minLat)
  .lte('lat', maxLat)
  .gte('lng', minLng)
  .lte('lng', maxLng)
  .eq('status', 'active')
  .order('google_rating', { ascending: false, nullsFirst: false });

// Calculate actual distance and filter by radius
const venuesWithDistance = (venues || []).map(venue => {
  const distance = calculateDistance(lat, lng, venue.lat, venue.lng);
  return { ...venue, distance };
}).filter(v => v.distance <= radius).sort((a, b) => a.distance - b.distance);

// Helper function to calculate distance using Haversine formula
function calculateDistance(lat1: number, lon1: number, lat2: number, lon2: number): number {
  const R = 3959; // Earth's radius in miles
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a =
    Math.sin(dLat / 2) * Math.sin(dLat / 2) +
    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
    Math.sin(dLon / 2) * Math.sin(dLon / 2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  return R * c;
}

const title = `Autism-Friendly Venues near ${address || 'you'}`;
const description = `Found ${venuesWithDistance.length} autism-friendly venues within ${radius} miles. Museums, parks, libraries, and more with sensory accommodations.`;
const MAPBOX_TOKEN = import.meta.env.PUBLIC_MAPBOX_TOKEN;
---

<Base title={title} description={description}>
  <!-- Mapbox GL JS -->
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.css" rel="stylesheet" />
  <script src="https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.js"></script>
  <div class="min-h-screen bg-gray-50">
    <!-- Search Header -->
    <div class="bg-white border-b border-gray-200 sticky top-16 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex items-center justify-between gap-4">
          <div class="flex-1">
            <h1 class="text-2xl font-bold text-gray-900">
              {venuesWithDistance.length} venues near you
            </h1>
            <p class="text-sm text-gray-600 mt-1">
              {address || `${lat.toFixed(4)}, ${lng.toFixed(4)}`} · Within {radius} miles
            </p>
          </div>

          <a
            href="/"
            class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
          >
            New Search
          </a>
        </div>
      </div>
    </div>

    <!-- Results Container -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Filters Column (Left) -->
        <div class="lg:col-span-1">
          <div class="sticky top-32">
            <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
              <!-- Filter Header -->
              <div class="p-4 border-b border-gray-200">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <h3 class="text-lg font-semibold text-gray-900">Filters</h3>
                    <span id="filter-count" class="hidden inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800"></span>
                  </div>
                </div>
              </div>

              <!-- Filter Body -->
              <div class="p-4 space-y-6">
                <!-- Sort By -->
                <div>
                  <label class="block text-sm font-medium text-gray-900 mb-2">Sort By</label>
                  <select id="sort-select" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    <option value="distance">Closest First</option>
                    <option value="rating">Highest Rated</option>
                    <option value="name">Name (A-Z)</option>
                  </select>
                </div>

                <!-- Distance -->
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <label class="block text-sm font-medium text-gray-900">Max Distance</label>
                    <span id="distance-value" class="text-sm text-gray-600">{radius} mi</span>
                  </div>
                  <input type="range" id="distance-slider" min="1" max={radius} step="0.5" value={radius} class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600" />
                  <div class="flex justify-between text-xs text-gray-500 mt-1">
                    <span>1 mi</span>
                    <span>{radius} mi</span>
                  </div>
                </div>

                <!-- Min Rating -->
                <div>
                  <label class="block text-sm font-medium text-gray-900 mb-2">Minimum Rating</label>
                  <div class="grid grid-cols-5 gap-2" id="rating-buttons">
                    {[0, 3, 3.5, 4, 4.5].map(rating => (
                      <button data-rating={rating} class={`rating-btn px-2 py-2 text-sm font-medium rounded-lg transition-colors ${rating === 0 ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}>
                        {rating === 0 ? 'Any' : `${rating}+`}
                      </button>
                    ))}
                  </div>
                </div>

                <!-- Venue Types -->
                <div>
                  <label class="block text-sm font-medium text-gray-900 mb-2">Venue Type</label>
                  <div id="type-checkboxes" class="max-h-48 overflow-y-auto space-y-2"></div>
                </div>

                <!-- Verified Only -->
                <div>
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" id="verified-only" class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" />
                    <span class="text-sm font-medium text-gray-900">Verified venues only</span>
                  </label>
                </div>

                <!-- Clear Filters -->
                <button id="clear-filters" class="hidden w-full px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                  Clear all filters
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Map and Results Column (Right) -->
        <div class="lg:col-span-3">
          <!-- Map -->
          <div class="h-[500px] bg-white rounded-xl border border-gray-200 overflow-hidden mb-6">
            <div id="map" class="w-full h-full"></div>
          </div>

          <!-- Results List Below Map -->
          <div class="mb-4">
            <div class="text-sm font-medium text-gray-900">
              <span id="results-count">{venuesWithDistance.length}</span> venues found
            </div>
          </div>
          <div id="venue-list" class="space-y-4"></div>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ venues: venuesWithDistance, centerLat: lat, centerLng: lng, mapboxToken: MAPBOX_TOKEN }}>
    // State
    let allVenues = venues;
    let filteredVenues = venues;
    let map, markers = [];
    let filters = {
      sortBy: 'distance',
      maxDistance: Math.max(...venues.map(v => v.distance)),
      minRating: 0,
      selectedTypes: new Set(),
      verifiedOnly: false
    };

    // Initialize
    function init() {
      initMap();
      initFilters();
      renderVenueTypes();
      renderVenues();
    }

    // Init Mapbox Map
    function initMap() {
      if (typeof mapboxgl === 'undefined' || !mapboxToken) {
        document.getElementById('map').innerHTML = '<div class="flex items-center justify-center h-full bg-gray-100 text-gray-600 text-center p-4"><div><svg class="mx-auto h-12 w-12 text-gray-400 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg><p class="text-sm">Map loading...</p></div></div>';
        return;
      }

      mapboxgl.accessToken = mapboxToken;

      map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/streets-v12',
        center: [centerLng, centerLat],
        zoom: 12
      });

      // Add navigation controls
      map.addControl(new mapboxgl.NavigationControl(), 'top-right');

      // Wait for map to load before adding markers
      map.on('load', () => {
        // Add user location marker
        const userLocationEl = document.createElement('div');
        userLocationEl.className = 'user-location-marker';
        userLocationEl.style.width = '16px';
        userLocationEl.style.height = '16px';
        userLocationEl.style.borderRadius = '50%';
        userLocationEl.style.backgroundColor = '#3B82F6';
        userLocationEl.style.border = '2px solid white';
        userLocationEl.style.boxShadow = '0 2px 4px rgba(0,0,0,0.3)';

        new mapboxgl.Marker({ element: userLocationEl })
          .setLngLat([centerLng, centerLat])
          .setPopup(new mapboxgl.Popup({ offset: 15 }).setText('Your Location'))
          .addTo(map);

        // Now add venue markers
        updateMarkers();
      });
    }

    // Init Filters
    function initFilters() {
      document.getElementById('sort-select').addEventListener('change', (e) => {
        filters.sortBy = e.target.value;
        applyFilters();
      });

      document.getElementById('distance-slider').addEventListener('input', (e) => {
        filters.maxDistance = parseFloat(e.target.value);
        document.getElementById('distance-value').textContent = `${filters.maxDistance.toFixed(1)} mi`;
        applyFilters();
      });

      document.querySelectorAll('.rating-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const rating = parseFloat(btn.dataset.rating);
          filters.minRating = rating;
          document.querySelectorAll('.rating-btn').forEach(b => {
            b.className = b.dataset.rating === btn.dataset.rating
              ? 'rating-btn px-2 py-2 text-sm font-medium rounded-lg transition-colors bg-blue-600 text-white'
              : 'rating-btn px-2 py-2 text-sm font-medium rounded-lg transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200';
          });
          applyFilters();
        });
      });

      document.getElementById('verified-only').addEventListener('change', (e) => {
        filters.verifiedOnly = e.target.checked;
        applyFilters();
      });

      document.getElementById('clear-filters').addEventListener('click', () => {
        filters = {
          sortBy: 'distance',
          maxDistance: Math.max(...venues.map(v => v.distance)),
          minRating: 0,
          selectedTypes: new Set(),
          verifiedOnly: false
        };
        document.getElementById('sort-select').value = 'distance';
        document.getElementById('distance-slider').value = filters.maxDistance;
        document.getElementById('distance-value').textContent = `${filters.maxDistance.toFixed(1)} mi`;
        document.querySelectorAll('.rating-btn')[0].click();
        document.getElementById('verified-only').checked = false;
        document.querySelectorAll('.type-checkbox').forEach(cb => cb.checked = false);
        applyFilters();
      });
    }

    // Render venue types
    function renderVenueTypes() {
      const types = [...new Set(venues.map(v => v.type))].sort();
      const container = document.getElementById('type-checkboxes');
      container.innerHTML = types.map(type => {
        const count = venues.filter(v => v.type === type).length;
        return `
          <label class="flex items-center gap-2 cursor-pointer group">
            <input type="checkbox" data-type="${type}" class="type-checkbox w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" />
            <span class="text-sm text-gray-700 group-hover:text-gray-900">${type} (${count})</span>
          </label>
        `;
      }).join('');

      document.querySelectorAll('.type-checkbox').forEach(cb => {
        cb.addEventListener('change', (e) => {
          const type = e.target.dataset.type;
          if (e.target.checked) filters.selectedTypes.add(type);
          else filters.selectedTypes.delete(type);
          applyFilters();
        });
      });
    }

    // Apply filters
    function applyFilters() {
      let filtered = allVenues.filter(v => {
        if (v.distance > filters.maxDistance) return false;
        if (filters.minRating > 0 && (!v.google_rating || v.google_rating < filters.minRating)) return false;
        if (filters.selectedTypes.size > 0 && !filters.selectedTypes.has(v.type)) return false;
        if (filters.verifiedOnly && v.verification_status !== 'admin_verified') return false;
        return true;
      });

      // Sort
      filtered.sort((a, b) => {
        if (filters.sortBy === 'distance') return a.distance - b.distance;
        if (filters.sortBy === 'rating') return (b.google_rating || 0) - (a.google_rating || 0);
        if (filters.sortBy === 'name') return a.name.localeCompare(b.name);
        return 0;
      });

      filteredVenues = filtered;
      updateFilterCount();
      renderVenues();
      updateMarkers();
    }

    // Update filter count
    function updateFilterCount() {
      const count = (filters.selectedTypes.size > 0 ? 1 : 0) + (filters.minRating > 0 ? 1 : 0) +
                    (filters.maxDistance < Math.max(...venues.map(v => v.distance)) ? 1 : 0) +
                    (filters.verifiedOnly ? 1 : 0);
      const badge = document.getElementById('filter-count');
      const clearBtn = document.getElementById('clear-filters');
      if (count > 0) {
        badge.classList.remove('hidden');
        badge.textContent = `${count} active`;
        clearBtn.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
        clearBtn.classList.add('hidden');
      }
    }

    // Render venues
    function renderVenues() {
      const container = document.getElementById('venue-list');
      document.getElementById('results-count').textContent = filteredVenues.length;

      if (filteredVenues.length === 0) {
        container.innerHTML = `
          <div class="bg-white rounded-xl border border-gray-200 p-8 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h3 class="mt-2 text-lg font-medium text-gray-900">No venues match your filters</h3>
            <p class="mt-1 text-sm text-gray-500">Try adjusting your filters or expanding your search radius.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = filteredVenues.map((v, i) => `
        <a href="/venue/${v.slug}" data-index="${i}" class="venue-card block bg-white rounded-xl border border-gray-200 overflow-hidden hover:border-gray-300 hover:shadow-lg transition-all duration-200">
          <div class="p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold">${i + 1}</span>
                  <h3 class="text-lg font-semibold text-gray-900">${v.name}</h3>
                </div>
                <p class="text-sm text-gray-600 mb-2">${v.type} · ${v.distance.toFixed(1)} miles away</p>
                ${v.google_rating ? `
                  <div class="flex items-center gap-2 mb-2">
                    <div class="flex items-center">
                      ${'★'.repeat(Math.round(v.google_rating))}${'☆'.repeat(5 - Math.round(v.google_rating))}
                    </div>
                    <span class="text-sm text-gray-600">${v.google_rating.toFixed(1)} (${v.google_review_count || 0} reviews)</span>
                  </div>
                ` : ''}
                <p class="text-sm text-gray-600 line-clamp-2">${v.address}</p>
                ${v.verification_status === 'admin_verified' ? '<div class="mt-2 inline-flex items-center gap-1 px-2 py-1 bg-green-100 text-green-800 text-xs font-medium rounded">✓ Verified</div>' : ''}
              </div>
              ${v.photo_keys && v.photo_keys.length > 0 ? `<div class="w-24 h-24 rounded-lg overflow-hidden flex-shrink-0"><img src="${v.photo_keys[0]}" alt="${v.name}" class="w-full h-full object-cover" loading="lazy" /></div>` : ''}
            </div>
          </div>
        </a>
      `).join('');

      // Add hover listeners
      document.querySelectorAll('.venue-card').forEach((card, i) => {
        card.addEventListener('mouseenter', () => highlightMarker(i, true));
        card.addEventListener('mouseleave', () => highlightMarker(i, false));
      });
    }

    // Update markers with Mapbox
    function updateMarkers() {
      if (!map || typeof mapboxgl === 'undefined') return;

      // Remove old markers
      markers.forEach(m => m.remove());
      markers = [];

      // Create new markers for filtered venues
      filteredVenues.forEach((v, i) => {
        // Create custom marker element
        const el = document.createElement('div');
        el.className = 'venue-marker';
        el.style.width = '40px';
        el.style.height = '40px';
        el.style.borderRadius = '50%';
        el.style.backgroundColor = '#10B981';
        el.style.border = '2px solid white';
        el.style.boxShadow = '0 2px 4px rgba(0,0,0,0.3)';
        el.style.display = 'flex';
        el.style.alignItems = 'center';
        el.style.justifyContent = 'center';
        el.style.color = 'white';
        el.style.fontWeight = 'bold';
        el.style.fontSize = '12px';
        el.style.cursor = 'pointer';
        el.style.transition = 'all 0.2s';
        el.textContent = String(i + 1);
        el.dataset.index = i;

        // Create popup content
        const popupContent = `
          <div class="p-2">
            <h3 class="font-semibold text-gray-900">${v.name}</h3>
            <p class="text-sm text-gray-600">${v.type} · ${v.distance.toFixed(1)} mi</p>
            ${v.google_rating ? `<p class="text-sm text-gray-600">⭐ ${v.google_rating.toFixed(1)}</p>` : ''}
            <a href="/venue/${v.slug}" class="text-sm text-blue-600 hover:text-blue-700 font-medium">View Details →</a>
          </div>
        `;

        // Create marker
        const marker = new mapboxgl.Marker({ element: el })
          .setLngLat([v.lng, v.lat])
          .setPopup(new mapboxgl.Popup({ offset: 25 }).setHTML(popupContent))
          .addTo(map);

        markers.push(marker);
      });
    }

    // Highlight marker with Mapbox
    function highlightMarker(index, highlight) {
      if (!markers[index]) return;

      const el = markers[index].getElement();
      if (highlight) {
        el.style.width = '50px';
        el.style.height = '50px';
        el.style.backgroundColor = '#3B82F6';
        el.style.transform = 'scale(1.2)';
        el.style.zIndex = '1000';
      } else {
        el.style.width = '40px';
        el.style.height = '40px';
        el.style.backgroundColor = '#10B981';
        el.style.transform = 'scale(1)';
        el.style.zIndex = 'auto';
      }
    }

    // Start - Always initialize, even without Google Maps
    // This ensures venues are displayed regardless of map status
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</Base>
