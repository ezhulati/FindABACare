---
import Base from '../../../layouts/Base.astro';
import VenueCard from '../../../components/VenueCard.astro';
import MapIsland from '../../../components/MapIsland';
import { getServerClient } from '../../../lib/supabaseServer';
import { getStateName, isValidStateCode } from '../../../lib/states';
import { generateCityOGImage } from '../../../lib/seo';

const { state, city, type } = Astro.params;

if (!state || !isValidStateCode(state)) {
  return Astro.redirect('/cities');
}

const stateUpper = state!.toUpperCase();
const stateName = getStateName(stateUpper);

const supabase = getServerClient(Astro.request);

// Fetch city
const { data: cityData } = await supabase
  .from('cities')
  .select('*')
  .eq('slug', city)
  .eq('state', stateUpper)
  .eq('status', 'active')
  .single();

if (!cityData) {
  return Astro.redirect(`/${state}`);
}

// Venue type slug → display name mapping
const typeMap: Record<string, string> = {
  'museums': 'Museum',
  'parks': 'Park',
  'libraries': 'Library',
  'restaurants': 'Restaurant',
  'playgrounds': 'Playground',
  'indoor-play': 'Indoor Play',
  'movie-theaters': 'Movie Theater',
  'bowling-alleys': 'Bowling Alley',
  'aquariums': 'Aquarium',
  'zoos': 'Zoo',
  'art-galleries': 'Art Gallery',
  'science-museums': 'Science Museum',
  'childrens-museums': "Children's Museum",
  'nature-centers': 'Nature Center',
  'planetariums': 'Planetarium',
  'amusement-parks': 'Amusement Park',
  'tourist-attractions': 'Tourist Attraction',
};

const venueType = typeMap[type || ''];

// If not a recognized type, redirect to city page
if (!venueType) {
  return Astro.redirect(`/${state}/${city}`);
}

// Fetch venues of this type in this city
const { data: venues = [] } = await supabase
  .from('venues')
  .select('*')
  .eq('city_id', cityData.id)
  .eq('status', 'active')
  .ilike('type', venueType)
  .order('name');

// If no venues of this type, redirect to city page
if (venues.length === 0) {
  return Astro.redirect(`/${state}/${city}`);
}

const mapCenter: [number, number] = cityData.center_lat && cityData.center_lng
  ? [cityData.center_lng, cityData.center_lat]
  : [-96.7970, 32.7767];

const typePlural = type;
const title = `${venueType}s in ${cityData.name}, ${stateName} | autism.place`;
const description = `Find ${venues.length} autism-friendly ${venueType.toLowerCase()}s in ${cityData.name}, ${stateName}. Sensory-friendly accommodations, quiet hours, and parent reviews.`;
const { ogImage, ogImageAlt } = generateCityOGImage(cityData.name);

// JSON-LD
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Autism-Friendly ${venueType}s in ${cityData.name}, ${stateName}`,
  "numberOfItems": venues.length,
  "itemListElement": venues.slice(0, 20).map((v: any, i: number) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Place",
      "name": v.name,
      "url": `https://autism.place/venue/${v.slug}`,
      ...(v.address ? { "address": v.address } : {})
    }
  }))
};
---

<Base title={title} description={description} ogImage={ogImage} ogImageAlt={ogImageAlt} currentPath={Astro.url.pathname}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-sm text-gray-600 mb-6 flex-wrap" aria-label="Breadcrumb">
      <a href="/" class="hover:text-gray-900">Home</a>
      <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <a href={`/${state}`} class="hover:text-gray-900">{stateName}</a>
      <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <a href={`/${state}/${city}`} class="hover:text-gray-900">{cityData.name}</a>
      <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-gray-900">{venueType}s</span>
    </nav>

    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-3">
        {venueType}s in {cityData.name}
      </h1>
      <p class="text-lg text-gray-600">
        {venues.length} autism-friendly {venueType.toLowerCase()}{venues.length !== 1 ? 's' : ''} with sensory accommodations
      </p>
    </div>

    <!-- Quick links to other types -->
    <div class="flex gap-3 mb-8 overflow-x-auto pb-2">
      <a
        href={`/${state}/${city}`}
        class="px-4 py-2 bg-gray-100 border border-gray-200 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 whitespace-nowrap transition-colors"
      >
        All Venues
      </a>
      <a
        href={`/${state}/${city}/events`}
        class="px-4 py-2 bg-gray-100 border border-gray-200 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 whitespace-nowrap transition-colors"
      >
        Events
      </a>
    </div>

    <!-- Map + Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Map sidebar -->
      <div class="lg:col-span-1">
        <div class="lg:sticky lg:top-20">
          <div class="bg-white rounded-lg border border-gray-200 p-4">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Map View</h2>
            <MapIsland
              client:load
              venues={venues.map(v => ({
                id: v.id,
                name: v.name,
                slug: v.slug,
                lat: v.lat,
                lng: v.lng,
                type: v.type,
                meter: v.meter
              }))}
              initialCenter={mapCenter}
              initialZoom={11}
            />
          </div>
        </div>
      </div>

      <!-- Venues grid -->
      <div class="lg:col-span-3">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-gray-900">
            {venueType}s ({venues.length})
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {venues.map((venue) => (
            <VenueCard venue={venue} />
          ))}
        </div>
      </div>
    </div>
  </div>
</Base>
