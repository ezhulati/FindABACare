---
import Base from '../../layouts/Base.astro';
import { createClient } from '@supabase/supabase-js';
import MapboxAddressSearch from '../../components/MapboxAddressSearch';

const { state } = Astro.params;

// Mapbox Token
const MAPBOX_TOKEN = import.meta.env.PUBLIC_MAPBOX_TOKEN;

// Initialize Supabase
const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL!,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY!
);

// Fetch all cities in this state
console.log(`[state]/index.astro: Fetching cities for state="${state}"`);
const { data: cities, error: citiesError } = await supabase
  .from('cities')
  .select('id, name, slug, state, center_lat, center_lng, population, priority_tier')
  .eq('status', 'active')
  .ilike('state', state!)
  .order('population', { ascending: false });

console.log(`[state]/index.astro: Query result:`, { citiesCount: cities?.length, error: citiesError });

// If no cities found, redirect to cities page
if (!cities || cities.length === 0) {
  console.log(`[state]/index.astro: No cities found for "${state}", redirecting to /cities`);
  return Astro.redirect('/cities');
}

// Get venue counts for each city
const citiesWithCounts = await Promise.all(
  cities.map(async (city) => {
    const { count } = await supabase
      .from('venues')
      .select('id', { count: 'exact', head: true })
      .eq('city_id', city.id)
      .eq('status', 'active');

    return {
      ...city,
      venueCount: count || 0
    };
  })
);

const totalVenues = citiesWithCounts.reduce((sum, city) => sum + city.venueCount, 0);
const stateName = cities[0].state;
const stateNameFull = stateName; // Could map to full names if needed

const title = `${stateNameFull} Autism-Friendly Venues | autism.place`;
const description = `Discover ${totalVenues.toLocaleString()}+ autism-friendly venues across ${cities.length} cities in ${stateNameFull}. Find sensory-friendly museums, parks, libraries, and more.`;

// Note: getStaticPaths() is not needed in SSR mode (output: 'server')
---

<Base title={title} description={description}>
  <div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <div class="bg-white border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="text-center">
          <h1 class="text-4xl font-bold text-gray-900 mb-4">
            Autism-Friendly Venues in {stateName}
          </h1>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
            Discover {totalVenues.toLocaleString()}+ sensory-friendly venues across {cities.length} {cities.length === 1 ? 'city' : 'cities'} in {stateName}
          </p>

          <!-- Address Search -->
          <div class="flex justify-center">
            <MapboxAddressSearch client:load mapboxToken={MAPBOX_TOKEN} />
          </div>
        </div>
      </div>
    </div>

    <!-- Cities Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">Cities in {stateName}</h2>
        <p class="text-gray-600">
          Browse autism-friendly venues by city
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {citiesWithCounts.map(city => (
          <a
            href={`/${city.state.toLowerCase()}/${city.slug}`}
            class="block bg-white rounded-lg border border-gray-200 p-6 hover:border-blue-500 hover:shadow-lg transition-all duration-200 group"
          >
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
                  {city.name}
                </h3>
                {city.population && (
                  <p class="text-sm text-gray-600 mt-1">
                    {(city.population / 1000000).toFixed(1)}M people
                  </p>
                )}
              </div>

              {city.priority_tier <= 2 && (
                <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-blue-100 text-blue-800">
                  Featured
                </span>
              )}
            </div>

            <div class="flex items-center gap-2 text-gray-600 mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
              <span class="font-medium">{city.venueCount} venues</span>
            </div>

            <div class="flex items-center text-sm text-blue-600 font-medium group-hover:text-blue-700">
              <span>View venues</span>
              <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- CTA Section -->
    <div class="bg-blue-600 mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">
          Looking for venues in other states?
        </h2>
        <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
          We have autism-friendly venues across all 50 states. Browse our full directory to find places near you.
        </p>
        <a
          href="/cities"
          class="inline-flex items-center px-6 py-3 border-2 border-white text-white font-medium rounded-lg hover:bg-white hover:text-blue-600 transition-all duration-200"
        >
          View All Cities
        </a>
      </div>
    </div>
  </div>
</Base>
