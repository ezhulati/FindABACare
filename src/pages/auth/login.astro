---
import Base from '../../layouts/Base.astro';
import { getAuthUser, getServerClient } from '../../lib/supabaseServer';

// Get redirect URL from query params
const url = new URL(Astro.request.url);
const redirect = url.searchParams.get('redirect') || '/';

// Check if user is already logged in
const user = await getAuthUser(Astro.request);
if (user) {
  // Check if they have a profile
  const supabase = getServerClient(Astro.request);
  const { data: profile } = await supabase
    .from('profiles')
    .select('id')
    .eq('auth_user', user.id)
    .single();

  // If no profile, send to onboarding
  if (!profile) {
    return Astro.redirect('/onboarding');
  }

  // User is already logged in with profile, redirect them
  return Astro.redirect(redirect);
}

const title = 'Sign In | findABA.care';
const description = 'Sign in to leave reviews and access personalized features.';
---

<Base title={title} description={description}>
  <div class="flex items-center justify-center min-h-[calc(100vh-4rem)] px-4 py-12 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
      <div class="text-center">
        <h1 class="text-4xl font-bold text-gray-900 mb-3">Sign In</h1>
        <p class="text-gray-600 text-lg">
          Enter your email to receive a magic link
        </p>
      </div>

      <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-8">
        <form id="login-form" class="space-y-6">
          <div>
            <label for="email" class="block text-sm font-medium text-gray-900 mb-2">
              Email address
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="your@email.com"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow"
            />
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all disabled:bg-gray-400 disabled:cursor-not-allowed"
          >
            Send magic link
          </button>

          <div id="message" class="hidden p-4 rounded-lg"></div>
        </form>

        <div class="mt-6 pt-6 border-t border-gray-200">
          <p class="text-sm text-gray-600 text-center">
            We'll email you a magic link for a password-free sign in
          </p>
        </div>
      </div>

      <div class="text-center">
        <a href="/" class="inline-flex items-center gap-2 text-sm text-gray-600 hover:text-gray-900 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to home
        </a>
      </div>
    </div>
  </div>

  <script define:vars={{ redirect }}>
    import { createClient } from '@supabase/supabase-js';

    console.log('Initializing Supabase client...');
    console.log('Supabase URL:', import.meta.env.PUBLIC_SUPABASE_URL);
    console.log('Redirect after login:', redirect);

    const supabase = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );

    const form = document.getElementById('login-form');
    const emailInput = document.getElementById('email');
    const submitBtn = document.getElementById('submit-btn');
    const messageDiv = document.getElementById('message');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const email = emailInput.value;
      console.log('Attempting to send magic link to:', email);

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      messageDiv.classList.add('hidden');

      try {
        const redirectUrl = `${window.location.origin}${redirect}`;
        console.log('Email redirect URL:', redirectUrl);

        const { data, error } = await supabase.auth.signInWithOtp({
          email,
          options: {
            emailRedirectTo: `${window.location.origin}/auth/callback`,
          },
        });

        console.log('Supabase response:', { data, error });

        if (error) throw error;

        // Show success message
        messageDiv.className = 'block p-4 rounded-lg bg-green-50 border border-green-200 text-green-800';
        messageDiv.textContent = '✅ Check your email for the magic link! (Check spam folder if not received)';
        emailInput.value = '';
        console.log('Magic link sent successfully!');
      } catch (error) {
        console.error('Error sending magic link:', error);

        // Show error message
        messageDiv.className = 'block p-4 rounded-lg bg-red-50 border border-red-200 text-red-800';

        // Provide more helpful error messages
        if (error.message?.includes('Email rate limit exceeded')) {
          messageDiv.textContent = '⚠️ Too many requests. Please wait a few minutes before trying again.';
        } else if (error.message?.includes('not authorized')) {
          messageDiv.textContent = '⚠️ Email authentication is not enabled. Please contact support.';
        } else {
          messageDiv.textContent = `❌ ${error.message || 'Error sending magic link. Please try again.'}`;
        }
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send magic link';
      }
    });
  </script>
</Base>
