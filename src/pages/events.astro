---
import Base from '../layouts/Base.astro';
import RSVPButtonIsland from '../components/RSVPButtonIsland';
import { getServerClient } from '../lib/supabaseServer';
import { formatTime, generateICS } from '../lib/utils';
import dayjs from 'dayjs';

const supabase = getServerClient(Astro.request);

// State names map for display
const stateNames: Record<string, string> = {
  'TX': 'Texas',
  'CA': 'California',
  'NY': 'New York',
  'FL': 'Florida',
  'AZ': 'Arizona',
  'PA': 'Pennsylvania',
  'GA': 'Georgia',
  'NC': 'North Carolina',
  'MI': 'Michigan',
  'OH': 'Ohio',
  'TN': 'Tennessee',
  'IN': 'Indiana',
  'MD': 'Maryland',
  'WI': 'Wisconsin',
  'CO': 'Colorado',
  'VA': 'Virginia',
  'WA': 'Washington',
  'MA': 'Massachusetts',
  'OR': 'Oregon',
  'IL': 'Illinois'
};

// Fetch all upcoming events nationwide
const { data: events } = await supabase
  .from('events')
  .select(`
    *,
    venue:venues(*),
    city:cities(*),
    rsvp_count:rsvps(count)
  `)
  .eq('status', 'published')
  .eq('approval_status', 'approved')
  .gte('date', dayjs().format('YYYY-MM-DD'))
  .order('date')
  .order('start_time')
  .limit(100);

// Process events to add RSVP counts and location info
const processedEvents = (events || []).map(event => ({
  ...event,
  rsvpCount: event.rsvp_count?.[0]?.count || 0,
  cityName: event.city?.name || '',
  stateName: stateNames[event.city?.state] || event.city?.state || '',
  stateCode: event.city?.state || '',
  citySlug: event.city?.slug || ''
}));

// Group featured events (next 2 weeks, in popular cities)
const featuredCutoff = dayjs().add(14, 'days').format('YYYY-MM-DD');
const featuredCities = ['dallas', 'houston', 'austin', 'phoenix', 'los-angeles', 'san-diego', 'new-york', 'chicago'];
const featuredEvents = processedEvents.filter(
  event => event.date <= featuredCutoff && (event.is_featured || featuredCities.includes(event.citySlug))
).slice(0, 6);

// Group events by state for filtering
const eventsByState = processedEvents.reduce((acc, event) => {
  const state = event.stateCode;
  if (!acc[state]) acc[state] = [];
  acc[state].push(event);
  return acc;
}, {} as Record<string, typeof processedEvents>);

const totalEvents = processedEvents.length;
const totalStates = Object.keys(eventsByState).length;

const title = 'Nationwide Events | autism.place';
const description = `Find autism-friendly micro-events happening nationwide. ${totalEvents} upcoming events across ${totalStates} states. Small group meetups at sensory-friendly venues.`;
---

<Base title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Hero Header -->
    <div class="text-center mb-12">
      <h1 class="text-5xl font-bold text-gray-900 mb-4">
        Nationwide Events
      </h1>
      <p class="text-xl text-gray-600 mb-2">
        Autism-friendly micro-events happening across the country
      </p>
      <div class="flex items-center justify-center gap-4 text-sm text-gray-500">
        <span class="flex items-center gap-1">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
          </svg>
          {totalEvents} upcoming events
        </span>
        <span class="flex items-center gap-1">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
          </svg>
          {totalStates} states
        </span>
      </div>
    </div>

    <!-- Featured Events Section -->
    {featuredEvents.length > 0 && (
      <div class="mb-12">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-bold text-gray-900">Featured Events</h2>
          <span class="text-sm text-gray-500">Next 2 weeks</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {featuredEvents.map((event) => (
            <article class="bg-gradient-to-br from-purple-50 to-blue-50 border-2 border-purple-200 rounded-xl p-6 hover:shadow-xl transition-all">
              <!-- Event Badge -->
              <div class="flex items-start justify-between gap-4 mb-4">
                <span class="inline-block px-3 py-1 bg-purple-600 text-white text-xs font-semibold rounded-full">
                  FEATURED
                </span>
                <div class="text-right">
                  <div class="text-2xl font-bold text-gray-900">
                    {dayjs(event.date).format('D')}
                  </div>
                  <div class="text-xs text-gray-600 uppercase">
                    {dayjs(event.date).format('MMM')}
                  </div>
                </div>
              </div>

              <!-- Event Title -->
              <h3 class="text-xl font-semibold text-gray-900 mb-2">{event.title}</h3>

              <!-- Location -->
              <div class="flex items-center gap-2 text-sm text-gray-700 mb-3">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                </svg>
                <span class="font-medium">{event.cityName}, {event.stateCode}</span>
              </div>

              <!-- Time -->
              <div class="flex items-center gap-2 text-sm text-gray-600 mb-4">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>{formatTime(event.start_time)} - {formatTime(event.end_time)}</span>
              </div>

              <!-- CTA Button -->
              {event.event_type === 'partner' && event.source_url ? (
                <a
                  href={event.source_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full text-center px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors flex items-center justify-center gap-2"
                >
                  <span>RSVP on {event.source_name || 'Partner Site'}</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              ) : (
                <a
                  href={`/${event.stateCode.toLowerCase()}/${event.citySlug}/events#${event.id}`}
                  class="block w-full text-center px-4 py-2 bg-purple-600 text-white font-medium rounded-lg hover:bg-purple-700 transition-colors"
                >
                  View Details & RSVP
                </a>
              )}
            </article>
          ))}
        </div>
      </div>
    )}

    <!-- State Filter Tabs -->
    <div class="mb-8">
      <div class="flex items-center gap-2 mb-4">
        <svg class="w-5 h-5 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
        </svg>
        <h2 class="text-lg font-semibold text-gray-900">Filter by State</h2>
      </div>
      <div class="flex flex-wrap gap-2">
        <button
          class="state-filter px-4 py-2 bg-gray-900 text-white rounded-lg text-sm font-medium transition-colors"
          data-state="all"
        >
          All States ({totalEvents})
        </button>
        {Object.keys(eventsByState).sort().map((stateCode) => (
          <button
            class="state-filter px-4 py-2 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-lg text-sm font-medium transition-colors"
            data-state={stateCode}
          >
            {stateNames[stateCode] || stateCode} ({eventsByState[stateCode].length})
          </button>
        ))}
      </div>
    </div>

    <!-- All Events Grid -->
    <div>
      <h2 class="text-2xl font-bold text-gray-900 mb-6">All Upcoming Events</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" id="events-grid">
        {processedEvents.map((event) => (
          <article class="event-card bg-white border border-gray-200 rounded-xl p-6 hover:border-gray-300 hover:shadow-lg transition-all" data-state={event.stateCode}>
            <!-- Event Header -->
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-gray-900 mb-1">{event.title}</h3>
                <div class="flex items-center gap-2 text-sm text-gray-600">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  </svg>
                  <a
                    href={`/${event.stateCode.toLowerCase()}/${event.citySlug}`}
                    class="text-blue-600 hover:text-blue-700"
                  >
                    {event.cityName}, {event.stateName}
                  </a>
                </div>
              </div>
              <div class="text-right">
                <div class="text-2xl font-bold text-gray-900">
                  {dayjs(event.date).format('D')}
                </div>
                <div class="text-xs text-gray-600 uppercase">
                  {dayjs(event.date).format('MMM')}
                </div>
              </div>
            </div>

            <!-- Event Details -->
            <div class="space-y-2 mb-4 text-sm text-gray-600">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>{formatTime(event.start_time)} - {formatTime(event.end_time)}</span>
              </div>
              {event.venue && (
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                  <span>{event.venue.name}</span>
                </div>
              )}
              {event.age_range && (
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                  <span>Ages {event.age_range}</span>
                </div>
              )}
            </div>

            {event.description && (
              <p class="text-gray-700 text-sm leading-relaxed mb-4 line-clamp-2">
                {event.description}
              </p>
            )}

            <!-- Event Type Badge -->
            {event.event_type && (
              <div class="mb-4">
                {event.event_type === 'partner' && (
                  <span class="inline-block px-3 py-1 bg-blue-100 text-blue-700 text-xs font-medium rounded-full">
                    Partner Event{event.source_name ? ` · ${event.source_name}` : ''}
                  </span>
                )}
                {event.event_type === 'official' && (
                  <span class="inline-block px-3 py-1 bg-purple-100 text-purple-700 text-xs font-medium rounded-full">
                    autism.place Official
                  </span>
                )}
                {event.event_type === 'community' && (
                  <span class="inline-block px-3 py-1 bg-green-100 text-green-700 text-xs font-medium rounded-full">
                    Community Event
                  </span>
                )}
              </div>
            )}

            <!-- Actions -->
            <div class="flex items-center gap-3">
              {event.event_type === 'partner' && event.source_url ? (
                <a
                  href={event.source_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 text-center px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors flex items-center justify-center gap-2"
                >
                  <span>RSVP on {event.source_name || 'Partner Site'}</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              ) : (
                <a
                  href={`/${event.stateCode.toLowerCase()}/${event.citySlug}/events#${event.id}`}
                  class="flex-1 text-center px-4 py-2 bg-black text-white font-medium rounded-lg hover:bg-gray-800 transition-colors"
                >
                  View Details & RSVP
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- CTA Section -->
    <div class="mt-16 bg-gradient-to-r from-purple-600 to-blue-600 rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-white mb-3">Want to host an event in your city?</h2>
      <p class="text-purple-100 mb-6 max-w-2xl mx-auto">
        We partner with venues and parents to create more sensory-friendly events nationwide.
        Get in touch to learn more about hosting events on autism.place.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/submit-event"
          class="inline-block px-6 py-3 bg-white text-purple-600 font-medium rounded-lg hover:bg-gray-50 transition-colors"
        >
          Submit an Event
        </a>
        <a
          href="/contact"
          class="inline-block px-6 py-3 bg-purple-700 text-white font-medium rounded-lg hover:bg-purple-800 transition-colors border-2 border-white"
        >
          Contact us
        </a>
      </div>
    </div>
  </div>

  <script>
    // Client-side state filtering
    const allCards = Array.from(document.querySelectorAll('.event-card'));
    const filterButtons = document.querySelectorAll('.state-filter');
    let currentState = 'all';

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const state = button.getAttribute('data-state');
        if (state === currentState) return;

        currentState = state;

        // Update button styles
        filterButtons.forEach(btn => {
          if (btn.getAttribute('data-state') === state) {
            btn.classList.remove('bg-gray-100', 'text-gray-700');
            btn.classList.add('bg-gray-900', 'text-white');
          } else {
            btn.classList.remove('bg-gray-900', 'text-white');
            btn.classList.add('bg-gray-100', 'text-gray-700');
          }
        });

        // Filter events
        allCards.forEach(card => {
          const cardState = card.getAttribute('data-state');
          if (state === 'all' || cardState === state) {
            (card as HTMLElement).style.display = '';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });

        // Scroll to events grid
        document.getElementById('events-grid')?.scrollIntoView({ behavior: 'smooth' });
      });
    });
  </script>
</Base>
