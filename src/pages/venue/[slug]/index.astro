---
import Base from '../../../layouts/Base.astro';
import SEO from '../../../components/SEO.astro';
import MapIsland from '../../../components/MapIsland';
import PhotoGallery from '../../../components/PhotoGallery';
import { VenueIconDetails } from '../../../components/VenueIconBadges';
import VenueVoteButton from '../../../components/VenueVoteButton';
import VenueReviewsList from '../../../components/VenueReviewsList';
import VenueReviewForm from '../../../components/VenueReviewForm';
import FavoriteButton from '../../../components/FavoriteButton';
import { getServerClient } from '../../../lib/supabaseServer';
import { goNow } from '../../../lib/goNow';
import { timeAgo, formatTime } from '../../../lib/utils';
import { generateVenueOGImage } from '../../../lib/seo';

const { slug } = Astro.params;

const supabase = getServerClient(Astro.request);

// Fetch venue (vote counts will be available after running migration)
const { data: venue } = await supabase
  .from('venues')
  .select(`
    *,
    city:cities(*)
  `)
  .eq('slug', slug)
  .eq('status', 'active')
  .single();

if (!venue) {
  return Astro.redirect('/');
}

// Fetch reviews
const { data: reviews = [] } = await supabase
  .from('reviews')
  .select('*, profile:profiles(*)')
  .eq('venue_id', venue.id)
  .eq('status', 'published')
  .order('created_at', { ascending: false })
  .limit(10);

// Calculate average ratings
const avgRatings = reviews.length > 0 ? {
  predictability: (reviews.reduce((sum, r) => sum + (r.predictability || 0), 0) / reviews.length).toFixed(1),
  sensoryLevel: (reviews.reduce((sum, r) => sum + (r.sensory_level || 0), 0) / reviews.length).toFixed(1),
  staffKnowledge: (reviews.reduce((sum, r) => sum + (r.staff_knowledge || 0), 0) / reviews.length).toFixed(1),
} : null;

const meter = venue.meter || goNow(venue.type);
const meterColors = {
  'Quiet': 'bg-green-100 text-green-800 border-green-200',
  'Moderate': 'bg-yellow-100 text-yellow-800 border-yellow-200',
  'Busy': 'bg-red-100 text-red-800 border-red-200',
};
const meterClass = meterColors[meter as keyof typeof meterColors] || meterColors.Moderate;

// Helper to format price level
const priceLabels = ['Free', '$', '$$', '$$$', '$$$$'];
const priceLabel = venue.price_level !== null && venue.price_level !== undefined
  ? priceLabels[venue.price_level]
  : null;

// Aggregate trigger warnings from reviews
const allTriggers = reviews
  .flatMap(r => r.triggers || [])
  .filter(Boolean);
const triggerCounts = allTriggers.reduce((acc, trigger) => {
  acc[trigger] = (acc[trigger] || 0) + 1;
  return acc;
}, {} as Record<string, number>);
const topTriggers = Object.entries(triggerCounts)
  .sort(([,a], [,b]) => b - a)
  .slice(0, 5)
  .map(([trigger]) => trigger);

const title = `${venue.name} - Autism-Friendly in ${venue.city?.name}`;
const description = `${venue.name} - Autism-friendly venue in ${venue.city?.name}. ${venue.description?.substring(0, 100) || 'See sensory hours, amenities, and parent reviews.'}`;
const { ogImage, ogImageAlt } = generateVenueOGImage(venue.type);

// Build JSON-LD Place schema
const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": venue.name,
  "description": venue.description || description,
  "address": venue.address ? {
    "@type": "PostalAddress",
    "streetAddress": venue.address,
    "addressLocality": venue.city?.name,
    "addressRegion": venue.city?.state || "TX",
    "addressCountry": "US"
  } : undefined,
  "geo": venue.lat && venue.lng ? {
    "@type": "GeoCoordinates",
    "latitude": venue.lat,
    "longitude": venue.lng
  } : undefined,
  "amenityFeature": venue.amenities ? Object.keys(venue.amenities)
    .filter(key => venue.amenities[key] === true)
    .map(key => ({
      "@type": "LocationFeatureSpecification",
      "name": key.replace(/_/g, ' '),
      "value": true
    })) : undefined,
  "aggregateRating": avgRatings ? {
    "@type": "AggregateRating",
    "ratingValue": ((parseFloat(avgRatings.predictability) + parseFloat(avgRatings.sensoryLevel) + parseFloat(avgRatings.staffKnowledge)) / 3).toFixed(1),
    "bestRating": "5",
    "worstRating": "1",
    "ratingCount": reviews.length
  } : undefined,
  "review": reviews.slice(0, 3).map(review => ({
    "@type": "Review",
    "author": {
      "@type": "Person",
      "name": review.profile?.display_name || "Anonymous Parent"
    },
    "reviewBody": review.content || "",
    "datePublished": review.created_at,
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": ((review.predictability + review.sensory_level + review.staff_knowledge) / 3).toFixed(1),
      "bestRating": "5",
      "worstRating": "1"
    }
  }))
};
---

<Base title={title} description={description} ogImage={ogImage} ogImageAlt={ogImageAlt}>
  <SEO
    title={title}
    description={description}
    type="place"
    schema={placeSchema}
  />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-sm text-gray-600 mb-6">
      <a href="/" class="hover:text-gray-900">Home</a>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <a href={`/${venue.city?.state?.toLowerCase() || 'tx'}/${venue.city?.slug}`} class="hover:text-gray-900">{venue.city?.name}</a>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-gray-900">{venue.name}</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Header -->
        <div class="bg-white rounded-lg border border-gray-200 p-6">
          <div class="flex items-start justify-between gap-4 mb-4">
            <div class="flex-1">
              <h1 class="text-3xl font-bold text-gray-900 mb-2">{venue.name}</h1>
              {venue.address && (
                <p class="text-gray-600 flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {venue.address}
                </p>
              )}
              {venue.type && (
                <p class="text-sm text-gray-500 mt-1">{venue.type}</p>
              )}
            </div>
            <div class="flex items-center gap-3">
              <FavoriteButton
                venueId={venue.id}
                venueName={venue.name}
                initialFavoriteCount={venue.favorite_count || 0}
                size="lg"
                showCount={true}
                client:load
              />
              <span class={`px-4 py-2 text-sm font-medium rounded-full border ${meterClass}`}>
                {meter}
              </span>
            </div>
          </div>

          {venue.description && (
            <p class="text-gray-700 leading-relaxed">{venue.description}</p>
          )}
        </div>

        <!-- Sensory Information (Icons display ONLY actual database data) -->
        <div class="bg-white rounded-lg border border-gray-200 p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Sensory-Friendly Information</h2>
          <VenueIconDetails
            venue={{
              type: venue.type || 'other',
              meter: meter,
              amenities: venue.amenities || {},
              triggers: venue.triggers || {},
              sensory_hours: venue.sensory_hours || []
            }}
            client:load
          />
        </div>

        <!-- Sensory Hours -->
        {venue.sensory_hours && Array.isArray(venue.sensory_hours) && venue.sensory_hours.length > 0 && (
          <div class="bg-white rounded-lg border border-gray-200 p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Sensory-Friendly Hours</h2>
            <div class="space-y-3">
              {venue.sensory_hours.map((hour: any) => (
                <div class="flex items-center justify-between p-3 bg-green-50 rounded-lg">
                  <div>
                    <p class="font-medium text-gray-900">{hour.day || 'Weekly'}</p>
                    {hour.description && (
                      <p class="text-sm text-gray-600">{hour.description}</p>
                    )}
                  </div>
                  <span class="text-sm font-medium text-gray-700">
                    {formatTime(hour.start_time)} - {formatTime(hour.end_time)}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Map -->
        {venue.lat && venue.lng && (
          <div class="bg-white rounded-lg border border-gray-200 p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Location</h2>
            <MapIsland
              client:load
              venues={[{
                id: venue.id,
                name: venue.name,
                slug: venue.slug,
                lat: venue.lat,
                lng: venue.lng,
                type: venue.type,
                meter: meter
              }]}
              initialCenter={[venue.lng, venue.lat]}
              initialZoom={14}
            />
          </div>
        )}

        <!-- Photos -->
        {venue.photo_keys && Array.isArray(venue.photo_keys) && venue.photo_keys.length > 0 && (
          <div>
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Photos</h2>
            <PhotoGallery
              client:load
              photos={venue.photo_keys}
              venueName={venue.name}
            />
          </div>
        )}

        <!-- Common Triggers (if any) -->
        {topTriggers.length > 0 && (
          <div class="bg-red-50 border border-red-200 rounded-lg p-6">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-red-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
              </svg>
              <div class="flex-1">
                <h2 class="text-lg font-semibold text-red-900 mb-2">Common Sensory Triggers</h2>
                <p class="text-sm text-red-700 mb-3">Parents have reported these potential triggers at this venue:</p>
                <div class="flex flex-wrap gap-2">
                  {topTriggers.map((trigger) => (
                    <span class="inline-flex items-center px-3 py-1.5 bg-white border border-red-300 text-red-800 text-sm font-medium rounded-full">
                      {trigger}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        )}

        <!-- Community Feedback: Voting + Reviews -->
        <div class="bg-white rounded-lg border border-gray-200 p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-6">Community Feedback</h2>

          <!-- Quick Vote Section -->
          <div class="mb-6 pb-6 border-b border-gray-200">
            <h3 class="text-sm font-medium text-gray-700 mb-3">How would you rate this venue?</h3>
            <VenueVoteButton
              venueId={venue.id}
              initialUpvotes={venue.upvotes || 0}
              initialDownvotes={venue.downvotes || 0}
              initialVoteScore={venue.vote_score || 0}
              size="md"
              client:load
            />
          </div>

          <!-- Reviews List with Aggregate Stats -->
          <VenueReviewsList
            venueId={venue.id}
            upvotes={venue.upvotes || 0}
            downvotes={venue.downvotes || 0}
            voteScore={venue.vote_score || 0}
            client:load
          />

          <!-- Write Review Form -->
          <div class="mt-6">
            <VenueReviewForm
              venueId={venue.id}
              venueName={venue.name}
              client:load
            />
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1">
        <div class="lg:sticky lg:top-20 space-y-6">
          <!-- Contact & Visit -->
          <div class="bg-white rounded-lg border border-gray-200 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Contact & Visit</h3>
            <div class="space-y-3">
              <!-- Phone -->
              {venue.formatted_phone_number && (
                <a
                  href={`tel:${venue.phone}`}
                  class="flex items-center gap-3 w-full px-4 py-3 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg transition-colors group"
                >
                  <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
                  </svg>
                  <div class="flex-1 text-left">
                    <div class="text-xs text-gray-600">Call</div>
                    <div class="text-sm font-medium text-gray-900 group-hover:text-blue-700">{venue.formatted_phone_number}</div>
                  </div>
                </a>
              )}

              <!-- Website -->
              {venue.website && (
                <a
                  href={venue.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3 w-full px-4 py-3 bg-purple-50 hover:bg-purple-100 border border-purple-200 rounded-lg transition-colors group"
                >
                  <svg class="w-5 h-5 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4.083 9h1.946c.089-1.546.383-2.97.837-4.118A6.004 6.004 0 004.083 9zM10 2a8 8 0 100 16 8 8 0 000-16zm0 2c-.076 0-.232.032-.465.262-.238.234-.497.623-.737 1.182-.389.907-.673 2.142-.766 3.556h3.936c-.093-1.414-.377-2.649-.766-3.556-.24-.56-.5-.948-.737-1.182C10.232 4.032 10.076 4 10 4zm3.971 5c-.089-1.546-.383-2.97-.837-4.118A6.004 6.004 0 0115.917 9h-1.946zm-2.003 2H8.032c.093 1.414.377 2.649.766 3.556.24.56.5.948.737 1.182.233.23.389.262.465.262.076 0 .232-.032.465-.262.238-.234.498-.623.737-1.182.389-.907.673-2.142.766-3.556zm1.166 4.118c.454-1.147.748-2.572.837-4.118h1.946a6.004 6.004 0 01-2.783 4.118zm-6.268 0C6.412 13.97 6.118 12.546 6.03 11H4.083a6.004 6.004 0 002.783 4.118z" clip-rule="evenodd"/>
                  </svg>
                  <div class="flex-1 text-left">
                    <div class="text-xs text-gray-600">Website</div>
                    <div class="text-sm font-medium text-gray-900 group-hover:text-purple-700 truncate">Visit Website →</div>
                  </div>
                </a>
              )}

              <!-- Directions -->
              {venue.lat && venue.lng && (
                <a
                  href={`https://www.google.com/maps/dir/?api=1&destination=${venue.lat},${venue.lng}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3 w-full px-4 py-3 bg-green-50 hover:bg-green-100 border border-green-200 rounded-lg transition-colors group"
                >
                  <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                  </svg>
                  <div class="flex-1 text-left">
                    <div class="text-xs text-gray-600">Navigate</div>
                    <div class="text-sm font-medium text-gray-900 group-hover:text-green-700">Get Directions →</div>
                  </div>
                </a>
              )}

              <!-- Price Level -->
              {priceLabel && (
                <div class="flex items-center gap-3 px-4 py-3 bg-gray-50 rounded-lg">
                  <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"/>
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"/>
                  </svg>
                  <div class="flex-1">
                    <div class="text-xs text-gray-600">Price Level</div>
                    <div class="text-sm font-medium text-gray-900">{priceLabel}</div>
                  </div>
                </div>
              )}
            </div>
          </div>

          <!-- Hours & Info -->
          <div class="bg-white rounded-lg border border-gray-200 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Hours & Info</h3>

            <!-- Hours of Operation -->
            {venue.hours && venue.hours.weekday_text && venue.hours.weekday_text.length > 0 && (
              <div class="mb-4">
                <h4 class="text-sm font-medium text-gray-700 mb-2">Hours</h4>
                <div class="space-y-1 text-sm">
                  {venue.hours.weekday_text.map((day: string) => (
                    <div class="text-gray-600">{day}</div>
                  ))}
                </div>
              </div>
            )}

            <!-- Ratings -->
            {venue.google_rating && (
              <div class="mb-4 pb-4 border-b border-gray-200">
                <h4 class="text-sm font-medium text-gray-700 mb-2">Google Rating</h4>
                <div class="flex items-center gap-2">
                  <div class="flex items-center">
                    {[...Array(5)].map((_, i) => (
                      <svg
                        class={`w-4 h-4 ${i < Math.round(venue.google_rating || 0) ? 'text-yellow-400' : 'text-gray-300'}`}
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))}
                  </div>
                  <span class="text-sm font-medium text-gray-900">{venue.google_rating.toFixed(1)}</span>
                  {venue.google_review_count && (
                    <span class="text-xs text-gray-500">({venue.google_review_count} reviews)</span>
                  )}
                </div>
              </div>
            )}

            <dl class="space-y-3 text-sm">
              <div>
                <dt class="text-gray-600">Go Now meter</dt>
                <dd class="font-medium text-gray-900">{meter}</dd>
              </div>
              {venue.city && (
                <div>
                  <dt class="text-gray-600">City</dt>
                  <dd class="font-medium text-gray-900">{venue.city.name}</dd>
                </div>
              )}
              {venue.verification_status === 'admin_verified' && (
                <div>
                  <dt class="text-gray-600">Verification</dt>
                  <dd class="flex items-center gap-1 text-green-700">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    Verified
                  </dd>
                </div>
              )}
              {venue.last_verified && (
                <div>
                  <dt class="text-gray-600">Last updated</dt>
                  <dd class="font-medium text-gray-900">{timeAgo(venue.last_verified)}</dd>
                </div>
              )}
            </dl>
          </div>

          <!-- Report Issue -->
          <div class="bg-white rounded-lg border border-gray-200 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Report an Issue</h3>
            <p class="text-sm text-gray-600 mb-4">
              Found incorrect info? Let us know so we can update it.
            </p>
            <a
              href={`/report?venue=${venue.id}`}
              class="block w-full px-4 py-2 border border-gray-300 text-gray-700 text-center font-medium rounded-lg hover:bg-gray-50 transition-colors"
            >
              Report
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>
