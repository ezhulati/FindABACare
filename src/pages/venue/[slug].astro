---
import Base from '../../layouts/Base.astro';
import MapIsland from '../../components/MapIsland';
import { getServerClient } from '../../lib/supabaseServer';
import { goNow } from '../../lib/goNow';
import { timeAgo, formatTime } from '../../lib/utils';

const { slug } = Astro.params;

const supabase = getServerClient(Astro.request);

// Fetch venue
const { data: venue } = await supabase
  .from('venues')
  .select(`
    *,
    city:cities(*)
  `)
  .eq('slug', slug)
  .eq('status', 'active')
  .single();

if (!venue) {
  return Astro.redirect('/');
}

// Fetch reviews
const { data: reviews = [] } = await supabase
  .from('reviews')
  .select('*, profile:profiles(*)')
  .eq('venue_id', venue.id)
  .eq('status', 'published')
  .order('created_at', { ascending: false })
  .limit(10);

// Calculate average ratings
const avgRatings = reviews.length > 0 ? {
  predictability: (reviews.reduce((sum, r) => sum + (r.predictability || 0), 0) / reviews.length).toFixed(1),
  sensoryLevel: (reviews.reduce((sum, r) => sum + (r.sensory_level || 0), 0) / reviews.length).toFixed(1),
  staffKnowledge: (reviews.reduce((sum, r) => sum + (r.staff_knowledge || 0), 0) / reviews.length).toFixed(1),
} : null;

const meter = venue.meter || goNow(venue.type);
const meterColors = {
  'Quiet': 'bg-green-100 text-green-800 border-green-200',
  'Moderate': 'bg-yellow-100 text-yellow-800 border-yellow-200',
  'Busy': 'bg-red-100 text-red-800 border-red-200',
};
const meterClass = meterColors[meter as keyof typeof meterColors] || meterColors.Moderate;

const title = `${venue.name} | findABA.care`;
const description = `${venue.name} - Autism-friendly venue in ${venue.city?.name}. See sensory hours, amenities, and parent reviews.`;
---

<Base title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-sm text-gray-600 mb-6">
      <a href="/" class="hover:text-gray-900">Home</a>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <a href={`/${venue.city?.slug}`} class="hover:text-gray-900">{venue.city?.name}</a>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-gray-900">{venue.name}</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Header -->
        <div class="bg-white rounded-lg border border-gray-200 p-6">
          <div class="flex items-start justify-between gap-4 mb-4">
            <div class="flex-1">
              <h1 class="text-3xl font-bold text-gray-900 mb-2">{venue.name}</h1>
              {venue.address && (
                <p class="text-gray-600 flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {venue.address}
                </p>
              )}
              {venue.type && (
                <p class="text-sm text-gray-500 mt-1">{venue.type}</p>
              )}
            </div>
            <span class={`px-4 py-2 text-sm font-medium rounded-full border ${meterClass}`}>
              {meter}
            </span>
          </div>

          {venue.description && (
            <p class="text-gray-700 leading-relaxed">{venue.description}</p>
          )}
        </div>

        <!-- Amenities -->
        {venue.amenities && (
          <div class="bg-white rounded-lg border border-gray-200 p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Amenities</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {venue.amenities.quiet_room && (
                <div class="flex items-center gap-3 p-3 bg-blue-50 rounded-lg">
                  <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10 2a8 8 0 100 16 8 8 0 000-16zM8 11a1 1 0 112 0v2a1 1 0 11-2 0v-2zm1-5a1 1 0 011 1v1a1 1 0 11-2 0V7a1 1 0 011-1z"/>
                  </svg>
                  <span class="text-sm font-medium text-gray-900">Quiet room available</span>
                </div>
              )}
              {venue.amenities.visual_supports && (
                <div class="flex items-center gap-3 p-3 bg-purple-50 rounded-lg">
                  <svg class="w-5 h-5 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                    <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-sm font-medium text-gray-900">Visual supports</span>
                </div>
              )}
              {venue.amenities.hand_dryer === false && (
                <div class="flex items-center gap-3 p-3 bg-green-50 rounded-lg">
                  <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M13.477 14.89A6 6 0 015.11 6.524l8.367 8.368zm1.414-1.414L6.524 5.11a6 6 0 018.367 8.367zM18 10a8 8 0 11-16 0 8 8 0 0116 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-sm font-medium text-gray-900">No hand dryers</span>
                </div>
              )}
              {venue.amenities.changing_table && (
                <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
                  <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-sm font-medium text-gray-900">Changing table</span>
                </div>
              )}
              {venue.amenities.wheelchair_accessible && (
                <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
                  <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-sm font-medium text-gray-900">Wheelchair accessible</span>
                </div>
              )}
            </div>
          </div>
        )}

        <!-- Sensory Hours -->
        {venue.sensory_hours && Array.isArray(venue.sensory_hours) && venue.sensory_hours.length > 0 && (
          <div class="bg-white rounded-lg border border-gray-200 p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Sensory-Friendly Hours</h2>
            <div class="space-y-3">
              {venue.sensory_hours.map((hour: any) => (
                <div class="flex items-center justify-between p-3 bg-green-50 rounded-lg">
                  <div>
                    <p class="font-medium text-gray-900">{hour.day || 'Weekly'}</p>
                    {hour.description && (
                      <p class="text-sm text-gray-600">{hour.description}</p>
                    )}
                  </div>
                  <span class="text-sm font-medium text-gray-700">
                    {formatTime(hour.start_time)} - {formatTime(hour.end_time)}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Map -->
        {venue.lat && venue.lng && (
          <div class="bg-white rounded-lg border border-gray-200 p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Location</h2>
            <MapIsland
              client:load
              venues={[{
                id: venue.id,
                name: venue.name,
                slug: venue.slug,
                lat: venue.lat,
                lng: venue.lng,
                type: venue.type,
                meter: meter
              }]}
              initialCenter={[venue.lng, venue.lat]}
              initialZoom={14}
            />
          </div>
        )}

        <!-- Reviews -->
        <div class="bg-white rounded-lg border border-gray-200 p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Parent Reviews</h2>

          {avgRatings && (
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6 p-4 bg-gray-50 rounded-lg">
              <div class="text-center">
                <div class="text-2xl font-bold text-gray-900">{avgRatings.predictability}</div>
                <div class="text-sm text-gray-600">Predictability</div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-gray-900">{avgRatings.sensoryLevel}</div>
                <div class="text-sm text-gray-600">Sensory Level</div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-gray-900">{avgRatings.staffKnowledge}</div>
                <div class="text-sm text-gray-600">Staff Knowledge</div>
              </div>
            </div>
          )}

          {reviews.length === 0 ? (
            <p class="text-gray-600 text-center py-8">No reviews yet. Be the first to review!</p>
          ) : (
            <div class="space-y-4">
              {reviews.map((review) => (
                <div class="border border-gray-200 rounded-lg p-4">
                  <div class="flex items-start justify-between mb-2">
                    <div class="flex-1">
                      <p class="font-medium text-gray-900">
                        {review.profile?.display_name || 'Anonymous Parent'}
                      </p>
                      <p class="text-sm text-gray-500">{timeAgo(review.created_at)}</p>
                    </div>
                    <div class="flex gap-2 text-sm">
                      <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded">
                        P: {review.predictability}/5
                      </span>
                      <span class="px-2 py-1 bg-purple-100 text-purple-700 rounded">
                        S: {review.sensory_level}/5
                      </span>
                    </div>
                  </div>
                  {review.content && (
                    <p class="text-gray-700 leading-relaxed">{review.content}</p>
                  )}
                  {review.best_time && (
                    <p class="text-sm text-gray-600 mt-2">
                      <strong>Best time:</strong> {review.best_time}
                    </p>
                  )}
                  {review.triggers && review.triggers.length > 0 && (
                    <div class="flex flex-wrap gap-2 mt-2">
                      {review.triggers.map((trigger: string) => (
                        <span class="px-2 py-1 bg-red-50 text-red-700 text-xs rounded">
                          {trigger}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}

          <a
            href={`/venue/${venue.slug}/review`}
            class="mt-6 block w-full px-4 py-3 bg-black text-white text-center font-medium rounded-lg hover:bg-gray-800 transition-colors"
          >
            Write a review
          </a>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1">
        <div class="lg:sticky lg:top-20 space-y-6">
          <!-- First Visit Kit -->
          <div class="bg-white rounded-lg border border-gray-200 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">First Visit Kit</h3>
            <p class="text-sm text-gray-600 mb-4">
              Get a personalized kit with visual supports and prep materials for this venue.
            </p>
            <a
              href={`/first-visit-kit?venue=${venue.id}`}
              class="block w-full px-4 py-2 bg-blue-600 text-white text-center font-medium rounded-lg hover:bg-blue-700 transition-colors"
            >
              Download Kit
            </a>
          </div>

          <!-- Quick Info -->
          <div class="bg-white rounded-lg border border-gray-200 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Quick Info</h3>
            <dl class="space-y-3 text-sm">
              {venue.last_verified && (
                <div>
                  <dt class="text-gray-600">Last verified</dt>
                  <dd class="font-medium text-gray-900">{timeAgo(venue.last_verified)}</dd>
                </div>
              )}
              <div>
                <dt class="text-gray-600">Go Now meter</dt>
                <dd class="font-medium text-gray-900">{meter}</dd>
              </div>
              {venue.city && (
                <div>
                  <dt class="text-gray-600">City</dt>
                  <dd class="font-medium text-gray-900">{venue.city.name}</dd>
                </div>
              )}
            </dl>
          </div>

          <!-- Report Issue -->
          <div class="bg-white rounded-lg border border-gray-200 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Report an Issue</h3>
            <p class="text-sm text-gray-600 mb-4">
              Found incorrect info? Let us know so we can update it.
            </p>
            <a
              href={`/report?venue=${venue.id}`}
              class="block w-full px-4 py-2 border border-gray-300 text-gray-700 text-center font-medium rounded-lg hover:bg-gray-50 transition-colors"
            >
              Report
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>
