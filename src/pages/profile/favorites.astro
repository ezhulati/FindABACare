---
import Base from '../../layouts/Base.astro';
import VenueCard from '../../components/VenueCard.astro';
import { getServerClient } from '../../lib/supabaseServer';
import { requireAuth } from '../../lib/auth';

const supabase = getServerClient(Astro.request);

// Require authentication
const user = await requireAuth(Astro);

// Get user's profile
const { data: profile } = await supabase
  .from('profiles')
  .select('id, display_name')
  .eq('id', user.id)
  .single();

if (!profile) {
  return Astro.redirect('/');
}

// Fetch user's favorited venues with full venue details
const { data: favorites, error } = await supabase
  .from('venue_favorites')
  .select(`
    id,
    created_at,
    venue:venues(
      id,
      name,
      slug,
      address,
      type,
      amenities,
      triggers,
      sensory_hours,
      last_verified,
      meter,
      photo_keys,
      google_rating,
      verification_status,
      favorite_count,
      city:cities(
        name,
        slug,
        state
      )
    )
  `)
  .eq('profile_id', profile.id)
  .order('created_at', { ascending: false });

// Filter out any null venues (in case venue was deleted)
const validFavorites = (favorites || []).filter(f => f.venue);

const title = 'My Favorites - autism.place';
const description = 'Your saved autism-friendly venues';
---

<Base title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-sm text-gray-600 mb-6">
      <a href="/" class="hover:text-gray-900">Home</a>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <a href="/profile" class="hover:text-gray-900">Profile</a>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-gray-900">My Favorites</span>
    </div>

    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <svg class="w-8 h-8 text-red-500" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
        </svg>
        <h1 class="text-3xl font-bold text-gray-900">My Favorites</h1>
      </div>
      <p class="text-gray-600">
        {validFavorites.length === 0
          ? "You haven't saved any venues yet. Start exploring and save your favorites!"
          : `You have ${validFavorites.length} saved ${validFavorites.length === 1 ? 'venue' : 'venues'}`
        }
      </p>
    </div>

    {error && (
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
        <p class="text-red-800">Error loading favorites. Please try again.</p>
      </div>
    )}

    {validFavorites.length === 0 ? (
      <!-- Empty State -->
      <div class="bg-white rounded-lg border border-gray-200 p-12 text-center">
        <div class="flex justify-center mb-6">
          <svg class="w-24 h-24 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </div>
        <h2 class="text-2xl font-semibold text-gray-900 mb-3">No Favorites Yet</h2>
        <p class="text-gray-600 mb-6 max-w-md mx-auto">
          Start exploring autism-friendly venues and save your favorites by clicking the heart icon on any venue.
        </p>
        <div class="flex justify-center gap-4">
          <a
            href="/"
            class="inline-flex items-center px-6 py-3 bg-purple-600 text-white font-medium rounded-lg hover:bg-purple-700 transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            Explore Venues
          </a>
          <a
            href="/cities"
            class="inline-flex items-center px-6 py-3 bg-white border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            </svg>
            Browse by City
          </a>
        </div>
      </div>
    ) : (
      <!-- Favorites Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {validFavorites.map((favorite) => (
          <VenueCard venue={favorite.venue} />
        ))}
      </div>
    )}

    <!-- Back to Profile Link -->
    <div class="mt-8 pt-8 border-t border-gray-200">
      <a
        href="/profile"
        class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors"
      >
        <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Profile
      </a>
    </div>
  </div>
</Base>
