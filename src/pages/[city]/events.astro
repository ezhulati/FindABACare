---
import Base from '../../layouts/Base.astro';
import RSVPButtonIsland from '../../components/RSVPButtonIsland';
import { getServerClient } from '../../lib/supabaseServer';
import { formatDate, formatTime, generateICS } from '../../lib/utils';
import dayjs from 'dayjs';

const { city } = Astro.params;

if (!['dallas', 'houston'].includes(city || '')) {
  return Astro.redirect('/');
}

const supabase = getServerClient(Astro.request);

// Fetch city
const { data: cityData } = await supabase
  .from('cities')
  .select('*')
  .eq('slug', city)
  .single();

if (!cityData) {
  return Astro.redirect('/');
}

// Fetch upcoming events
const { data: events = [] } = await supabase
  .from('events')
  .select(`
    *,
    venue:venues(*),
    rsvp_count:rsvps(count)
  `)
  .eq('city_id', cityData.id)
  .eq('status', 'published')
  .gte('date', dayjs().format('YYYY-MM-DD'))
  .order('date')
  .order('start_time')
  .limit(50);

// Process events to add RSVP counts
const processedEvents = events.map(event => ({
  ...event,
  rsvpCount: event.rsvp_count?.[0]?.count || 0
}));

const title = `${cityData.name} Events | FindABACare`;
const description = `Autism-friendly micro-events in ${cityData.name}. Small group meetups (max 12 kids) at sensory-friendly venues.`;
---

<Base title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-2 text-sm text-gray-600 mb-3">
        <a href="/" class="hover:text-gray-900">Home</a>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <a href={`/${city}`} class="hover:text-gray-900">{cityData.name}</a>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-gray-900">Events</span>
      </div>
      <h1 class="text-4xl font-bold text-gray-900 mb-3">
        {cityData.name} Events
      </h1>
      <p class="text-lg text-gray-600">
        Small group meetups (max 12 kids) at autism-friendly venues
      </p>
    </div>

    <!-- Info Banner -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-8">
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 text-blue-600 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
        </svg>
        <div class="flex-1">
          <h3 class="text-lg font-semibold text-blue-900 mb-1">About our micro-events</h3>
          <p class="text-blue-800">
            All events are capped at 12 kids to keep group sizes manageable. We partner with
            verified sensory-friendly venues to create safe, predictable experiences.
          </p>
        </div>
      </div>
    </div>

    <!-- Events Grid -->
    {processedEvents.length === 0 ? (
      <div class="text-center py-16 bg-gray-50 rounded-lg">
        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">No upcoming events</h3>
        <p class="text-gray-600 mb-6">Check back soon for new micro-events in your area</p>
        <a
          href={`/${city}`}
          class="inline-block px-6 py-3 bg-black text-white font-medium rounded-lg hover:bg-gray-800 transition-colors"
        >
          Explore venues
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {processedEvents.map((event) => (
          <article class="bg-white border border-gray-200 rounded-xl p-6 hover:border-gray-300 hover:shadow-lg transition-all">
            <!-- Event Header -->
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="flex-1">
                <h2 class="text-xl font-semibold text-gray-900 mb-1">{event.title}</h2>
                <a
                  href={`/venue/${event.venue?.slug || event.venue_id}`}
                  class="text-sm text-blue-600 hover:text-blue-700 flex items-center gap-1"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  </svg>
                  {event.venue?.name || 'View venue'}
                </a>
              </div>
              <div class="text-right">
                <div class="text-2xl font-bold text-gray-900">
                  {dayjs(event.date).format('D')}
                </div>
                <div class="text-xs text-gray-600 uppercase">
                  {dayjs(event.date).format('MMM')}
                </div>
              </div>
            </div>

            <!-- Event Details -->
            <div class="space-y-2 mb-4 text-sm text-gray-600">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>{formatTime(event.start_time)} - {formatTime(event.end_time)}</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                <span>Ages {event.age_range || '3-12'}</span>
              </div>
            </div>

            {event.description && (
              <p class="text-gray-700 text-sm leading-relaxed mb-4">
                {event.description}
              </p>
            )}

            <!-- Tags -->
            {event.tags && event.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-4">
                {event.tags.map((tag: string) => (
                  <span class="px-2 py-1 bg-gray-100 text-gray-700 text-xs rounded">
                    {tag}
                  </span>
                ))}
              </div>
            )}

            <!-- RSVP Section -->
            <div class="pt-4 border-t border-gray-200">
              <RSVPButtonIsland
                client:load
                eventId={event.id}
                currentCount={event.rsvpCount}
                capacity={event.capacity || 12}
              />
            </div>

            <!-- Calendar Download -->
            <div class="mt-3">
              <a
                href={`data:text/calendar;charset=utf-8,${encodeURIComponent(
                  generateICS({
                    title: event.title,
                    description: event.description || '',
                    location: event.venue?.address || '',
                    startDate: event.date,
                    startTime: event.start_time,
                    endDate: event.date,
                    endTime: event.end_time,
                    url: `https://findabacare.com/${city}/events#${event.id}`
                  })
                )}`}
                download={`${event.title.replace(/\s+/g, '-')}.ics`}
                class="inline-flex items-center gap-2 text-sm text-gray-600 hover:text-gray-900"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Add to calendar
              </a>
            </div>
          </article>
        ))}
      </div>
    )}

    <!-- Footer CTA -->
    <div class="mt-12 bg-gradient-to-r from-purple-600 to-blue-600 rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-white mb-3">Want to host an event?</h2>
      <p class="text-purple-100 mb-6 max-w-2xl mx-auto">
        We partner with venues and parents to create more sensory-friendly events.
        Get in touch to learn more.
      </p>
      <a
        href="/contact"
        class="inline-block px-6 py-3 bg-white text-purple-600 font-medium rounded-lg hover:bg-gray-50 transition-colors"
      >
        Contact us
      </a>
    </div>
  </div>
</Base>
