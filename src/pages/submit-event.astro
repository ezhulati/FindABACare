---
import Base from '../layouts/Base.astro';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL!,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY!
);

// Fetch cities for dropdown
const { data: cities } = await supabase
  .from('cities')
  .select('id, name, slug, state')
  .eq('status', 'active')
  .order('name', { ascending: true });

const citiesByState = (cities || []).reduce((acc, city) => {
  if (!acc[city.state]) {
    acc[city.state] = [];
  }
  acc[city.state].push(city);
  return acc;
}, {} as Record<string, typeof cities>);

const sortedStates = Object.keys(citiesByState).sort();
---

<Base
  title="Submit an Event | autism.place"
  description="Share an autism-friendly event with our community. Help families discover sensory-friendly activities and support group meetups."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">
        Submit an Autism-Friendly Event
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Know about an autism-friendly event? Share it with our community! All submissions are reviewed before publication.
      </p>
    </div>

    <!-- Success Message (hidden by default) -->
    <div id="success-message" class="hidden mb-8 p-4 bg-green-50 border border-green-200 rounded-lg">
      <div class="flex">
        <svg class="w-5 h-5 text-green-600 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-green-800">Event submitted successfully!</h3>
          <p class="text-sm text-green-700 mt-1">Thank you for contributing to our community. We'll review your submission and publish it within 24-48 hours.</p>
        </div>
      </div>
    </div>

    <!-- Error Message (hidden by default) -->
    <div id="error-message" class="hidden mb-8 p-4 bg-red-50 border border-red-200 rounded-lg">
      <div class="flex">
        <svg class="w-5 h-5 text-red-600 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">Error submitting event</h3>
          <p id="error-text" class="text-sm text-red-700 mt-1"></p>
        </div>
      </div>
    </div>

    <!-- Form -->
    <form id="event-form" class="bg-white shadow-sm rounded-lg border border-gray-200 p-8">
      <!-- Event Title -->
      <div class="mb-6">
        <label for="title" class="block text-sm font-medium text-gray-700 mb-2">
          Event Title <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="title"
          name="title"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder="e.g., Sensory-Friendly Movie Night"
        />
      </div>

      <!-- Description -->
      <div class="mb-6">
        <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
          Description <span class="text-red-500">*</span>
        </label>
        <textarea
          id="description"
          name="description"
          required
          rows="4"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder="Describe the event, what makes it autism-friendly, and what families can expect..."
        ></textarea>
      </div>

      <!-- Date and Time -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div>
          <label for="date" class="block text-sm font-medium text-gray-700 mb-2">
            Date <span class="text-red-500">*</span>
          </label>
          <input
            type="date"
            id="date"
            name="date"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>
        <div>
          <label for="start_time" class="block text-sm font-medium text-gray-700 mb-2">
            Start Time <span class="text-red-500">*</span>
          </label>
          <input
            type="time"
            id="start_time"
            name="start_time"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>
        <div>
          <label for="end_time" class="block text-sm font-medium text-gray-700 mb-2">
            End Time <span class="text-red-500">*</span>
          </label>
          <input
            type="time"
            id="end_time"
            name="end_time"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>
      </div>

      <!-- City Selection -->
      <div class="mb-6">
        <label for="city" class="block text-sm font-medium text-gray-700 mb-2">
          City <span class="text-red-500">*</span>
        </label>
        <select
          id="city"
          name="city_id"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">Select a city...</option>
          {sortedStates.map(state => (
            <optgroup label={state}>
              {citiesByState[state].map(city => (
                <option value={city.id}>{city.name}, {city.state}</option>
              ))}
            </optgroup>
          ))}
        </select>
      </div>

      <!-- Venue/Location -->
      <div class="mb-6">
        <label for="venue_name" class="block text-sm font-medium text-gray-700 mb-2">
          Venue Name <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="venue_name"
          name="venue_name"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder="e.g., Dallas Museum of Art"
        />
      </div>

      <div class="mb-6">
        <label for="venue_address" class="block text-sm font-medium text-gray-700 mb-2">
          Venue Address <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="venue_address"
          name="venue_address"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder="123 Main St, Dallas, TX 75201"
        />
      </div>

      <!-- Event URL (optional) -->
      <div class="mb-6">
        <label for="source_url" class="block text-sm font-medium text-gray-700 mb-2">
          Event URL (optional)
        </label>
        <input
          type="url"
          id="source_url"
          name="source_url"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder="https://example.com/event"
        />
        <p class="text-sm text-gray-500 mt-1">Link to event registration or more information</p>
      </div>

      <!-- Submitter Info -->
      <div class="border-t border-gray-200 pt-6 mb-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Your Information</h3>

        <div class="mb-4">
          <label for="submitter_name" class="block text-sm font-medium text-gray-700 mb-2">
            Your Name <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="submitter_name"
            name="submitter_name"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="mb-4">
          <label for="submitter_email" class="block text-sm font-medium text-gray-700 mb-2">
            Your Email <span class="text-red-500">*</span>
          </label>
          <input
            type="email"
            id="submitter_email"
            name="submitter_email"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
          <p class="text-sm text-gray-500 mt-1">We'll only use this to contact you about your submission</p>
        </div>
      </div>

      <!-- Submit Button -->
      <button
        type="submit"
        id="submit-btn"
        class="w-full px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
      >
        Submit Event for Review
      </button>
    </form>

    <!-- Info Box -->
    <div class="mt-8 p-6 bg-blue-50 border border-blue-200 rounded-lg">
      <h3 class="text-sm font-semibold text-blue-900 mb-2">What happens next?</h3>
      <ul class="text-sm text-blue-800 space-y-1">
        <li>• Your event will be reviewed by our team within 24-48 hours</li>
        <li>• We'll verify the autism-friendly features and accuracy</li>
        <li>• Once approved, it will appear on our events page</li>
        <li>• You'll receive an email confirmation when it's published</li>
      </ul>
    </div>
  </div>

  <script>
    const form = document.getElementById('event-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const successMessage = document.getElementById('success-message') as HTMLDivElement;
    const errorMessage = document.getElementById('error-message') as HTMLDivElement;
    const errorText = document.getElementById('error-text') as HTMLParagraphElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Disable submit button
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';

      // Hide messages
      successMessage.classList.add('hidden');
      errorMessage.classList.add('hidden');

      try {
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        const response = await fetch('/api/submit-event', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (response.ok) {
          // Show success message
          successMessage.classList.remove('hidden');
          form.reset();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          throw new Error(result.error || 'Failed to submit event');
        }
      } catch (error) {
        // Show error message
        errorText.textContent = error instanceof Error ? error.message : 'An unexpected error occurred';
        errorMessage.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } finally {
        // Re-enable submit button
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Event for Review';
      }
    });
  </script>
</Base>
