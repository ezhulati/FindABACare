---
import Base from '../layouts/Base.astro';
import { SEO_TEMPLATES, STOCK_IMAGES, checkSEOInDev } from '../lib/seo';
import AddressSearchIsland from '../components/AddressSearchIsland';
import { createClient } from '@supabase/supabase-js';

// SEO metadata for homepage
const { title, description, ogImage, ogImageAlt} = SEO_TEMPLATES.home;
checkSEOInDev({ title, description, ogImage, ogImageAlt }, '/');

const GOOGLE_MAPS_API_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || import.meta.env.GOOGLE_MAPS_API_KEY;

// Initialize Supabase
const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL!,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY!
);

// Fetch top 6 cities by venue count dynamically
const { data: citiesData } = await supabase
  .from('cities')
  .select('id, name, slug, state')
  .eq('status', 'active')
  .order('priority_tier', { ascending: true })
  .order('population', { ascending: false })
  .limit(20); // Get top 20 to calculate venue counts

// Get venue counts for each city
const citiesWithCounts = await Promise.all(
  (citiesData || []).map(async (city) => {
    const { count } = await supabase
      .from('venues')
      .select('id', { count: 'exact', head: true })
      .eq('city_id', city.id)
      .eq('status', 'active');

    return {
      ...city,
      venueCount: count || 0
    };
  })
);

// Sort by venue count and take top 6
const topCitiesByVenues = citiesWithCounts
  .sort((a, b) => b.venueCount - a.venueCount)
  .slice(0, 6);

// Map to display format with stock images
const imageMap = [
  STOCK_IMAGES.cityKids,
  STOCK_IMAGES.sensoryVenue,
  STOCK_IMAGES.group,
  STOCK_IMAGES.houstonOutdoor,
  STOCK_IMAGES.dallasOutdoor,
  STOCK_IMAGES.peacefulRoom,
];

const cities = topCitiesByVenues.map((city, index) => ({
  name: city.name,
  slug: city.slug,
  state: city.state,
  image: imageMap[index % imageMap.length],
  description: `Discover ${city.venueCount}+ autism-friendly venues in ${city.name}`,
}));
---

<Base title={title} description={description} ogImage={ogImage} ogImageAlt={ogImageAlt}>
  <div class="bg-gradient-to-b from-gray-50 to-white">
    <!-- Hero Section -->
    <section class="relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <!-- Hero Text -->
          <div>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight max-w-xl" style="text-wrap: balance;">
              Find autism-friendly places <span class="text-blue-600">near you</span>
            </h1>
            <p class="text-xl text-gray-600 mb-6 max-w-lg">
              Discover verified autism-friendly venues with quiet hours, visual guides, and sensory-friendly accommodations nationwide.
            </p>

            <!-- Address Search -->
            <div class="mb-8">
              <AddressSearchIsland client:load apiKey={GOOGLE_MAPS_API_KEY} />
            </div>

            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href="/cities"
                class="px-8 py-4 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors text-center"
              >
                Or browse by city
              </a>
            </div>
          </div>

          <!-- Hero Image -->
          <div class="relative">
            <img
              src={STOCK_IMAGES.cityKids}
              alt="Children enjoying autism-friendly activities"
              class="rounded-2xl shadow-2xl w-full h-auto"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-gray-200">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 text-blue-600 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Parent-Verified</h3>
          <p class="text-gray-600">
            Real experiences from parents who've been there. No guesswork, just honest reviews.
          </p>
        </div>

        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-green-100 text-green-600 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Go Now™ Meter</h3>
          <p class="text-gray-600">
            See predicted occupancy levels so you can plan visits during quieter times.
          </p>
        </div>

        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-purple-100 text-purple-600 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Small Group Meetups</h3>
          <p class="text-gray-600">
            Join micro-events (max 12 kids) designed for sensory-friendly socializing.
          </p>
        </div>
      </div>
    </section>

    <!-- Cities Section -->
    <section id="cities" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-gray-200">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          Popular cities
        </h2>
        <p class="text-lg text-gray-600">
          Browse curated venues in these cities, or search your location above
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {cities.map((city) => (
          <a
            href={`/${city.state.toLowerCase()}/${city.slug}`}
            class="group relative bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-gray-300 hover:shadow-xl transition-all duration-200"
          >
            <div class="relative aspect-video overflow-hidden">
              <img
                src={city.image}
                alt={`Autism-friendly venues in ${city.name}, ${city.state}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent flex items-end">
                <div class="p-6 text-white">
                  <div class="text-4xl font-bold mb-1">{city.name}</div>
                  <div class="text-xl opacity-90">{city.state}</div>
                </div>
              </div>
            </div>
            <div class="p-6">
              <p class="text-gray-600 mb-4">{city.description}</p>
              <span class="inline-flex items-center text-blue-600 font-medium group-hover:text-blue-700">
                Explore {city.name}
                <svg class="w-5 h-5 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Visual Features Showcase -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-gray-200">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          What makes a place autism-friendly?
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          We look for specific accommodations that make venues work for families
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="group">
          <div class="aspect-square overflow-hidden rounded-xl mb-4">
            <img
              src={STOCK_IMAGES.peacefulRoom}
              alt="Quiet sensory-friendly room"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Quiet Spaces</h3>
          <p class="text-gray-600">
            Designated calm areas and quiet rooms where kids can decompress when overwhelmed
          </p>
        </div>

        <div class="group">
          <div class="aspect-square overflow-hidden rounded-xl mb-4">
            <img
              src={STOCK_IMAGES.sensoryVenue}
              alt="Sensory-friendly public venue"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Visual Supports</h3>
          <p class="text-gray-600">
            Clear signage, visual schedules, and predictable layouts that reduce anxiety
          </p>
        </div>

        <div class="group">
          <div class="aspect-square overflow-hidden rounded-xl mb-4">
            <img
              src={STOCK_IMAGES.group}
              alt="Small group autism-friendly activities"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Trained Staff</h3>
          <p class="text-gray-600">
            Employees who understand autism and can provide appropriate support
          </p>
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-gray-200">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          How it works
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gray-900 text-white font-bold mb-4">
            1
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Browse venues</h3>
          <p class="text-sm text-gray-600">
            Filter by amenities like quiet rooms, visual supports, and sensory hours
          </p>
        </div>

        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gray-900 text-white font-bold mb-4">
            2
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Check the Go Now meter</h3>
          <p class="text-sm text-gray-600">
            See predicted occupancy to plan visits during quieter times
          </p>
        </div>

        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gray-900 text-white font-bold mb-4">
            3
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Join micro-events</h3>
          <p class="text-sm text-gray-600">
            RSVP to small-group meetups (max 12 kids) at verified venues
          </p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-gray-200">
      <div class="bg-gradient-to-r from-blue-600 to-purple-600 rounded-2xl p-8 sm:p-12 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
          Ready to explore?
        </h2>
        <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
          Join hundreds of families finding places that work for their kids
        </p>
        <a
          href="/cities"
          class="inline-block px-8 py-4 bg-white text-blue-600 font-medium rounded-lg hover:bg-gray-50 transition-colors"
        >
          Get started
        </a>
      </div>
    </section>
  </div>
</Base>
