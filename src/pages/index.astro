---
import Base from '../layouts/Base.astro';

const cities = [
  {
    name: 'Dallas',
    slug: 'dallas',
    state: 'TX',
    image: '/images/dallas.jpg',
    description: 'Discover autism-friendly venues and events in the Dallas-Fort Worth metroplex',
  },
  {
    name: 'Houston',
    slug: 'houston',
    state: 'TX',
    image: '/images/houston.jpg',
    description: 'Find sensory-friendly places and meetups across Greater Houston',
  },
];
---

<Base>
  <div class="bg-gradient-to-b from-gray-50 to-white">
    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 mb-6">
          Find places that work<br />
          <span class="text-blue-600">for your child</span>
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
          Quiet hours, visual guides, and small-group meetups verified by local parents.
          Autism-friendly venues in Dallas and Houston.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href="#cities"
            class="px-8 py-4 bg-black text-white font-medium rounded-lg hover:bg-gray-800 transition-colors"
          >
            Explore your city
          </a>
          <a
            href="/about"
            class="px-8 py-4 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors"
          >
            Learn more
          </a>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-gray-200">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 text-blue-600 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Parent-Verified</h3>
          <p class="text-gray-600">
            Real experiences from parents who've been there. No guesswork, just honest reviews.
          </p>
        </div>

        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-green-100 text-green-600 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Go Now™ Meter</h3>
          <p class="text-gray-600">
            See predicted occupancy levels so you can plan visits during quieter times.
          </p>
        </div>

        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-purple-100 text-purple-600 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Small Group Meetups</h3>
          <p class="text-gray-600">
            Join micro-events (max 12 kids) designed for sensory-friendly socializing.
          </p>
        </div>
      </div>
    </section>

    <!-- Cities Section -->
    <section id="cities" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-gray-200">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          Choose your city
        </h2>
        <p class="text-lg text-gray-600">
          Start exploring autism-friendly venues and events near you
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {cities.map((city) => (
          <a
            href={`/${city.slug}`}
            class="group relative bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-gray-300 hover:shadow-xl transition-all duration-200"
          >
            <div class="aspect-video bg-gradient-to-br from-blue-50 to-purple-50 flex items-center justify-center">
              <div class="text-center">
                <div class="text-6xl font-bold text-gray-900 mb-2">{city.name}</div>
                <div class="text-2xl text-gray-600">{city.state}</div>
              </div>
            </div>
            <div class="p-6">
              <p class="text-gray-600 mb-4">{city.description}</p>
              <span class="inline-flex items-center text-blue-600 font-medium group-hover:text-blue-700">
                Explore {city.name}
                <svg class="w-5 h-5 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-gray-200">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          How it works
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gray-900 text-white font-bold mb-4">
            1
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Browse venues</h3>
          <p class="text-sm text-gray-600">
            Filter by amenities like quiet rooms, visual supports, and sensory hours
          </p>
        </div>

        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gray-900 text-white font-bold mb-4">
            2
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Check the Go Now meter</h3>
          <p class="text-sm text-gray-600">
            See predicted occupancy to plan visits during quieter times
          </p>
        </div>

        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gray-900 text-white font-bold mb-4">
            3
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Download your kit</h3>
          <p class="text-sm text-gray-600">
            Get a personalized First Visit Kit with visual supports and prep materials
          </p>
        </div>

        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gray-900 text-white font-bold mb-4">
            4
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Join micro-events</h3>
          <p class="text-sm text-gray-600">
            RSVP to small-group meetups (max 12 kids) at verified venues
          </p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-gray-200">
      <div class="bg-gradient-to-r from-blue-600 to-purple-600 rounded-2xl p-8 sm:p-12 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
          Ready to explore?
        </h2>
        <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
          Join hundreds of families finding places that work for their kids
        </p>
        <a
          href="#cities"
          class="inline-block px-8 py-4 bg-white text-blue-600 font-medium rounded-lg hover:bg-gray-50 transition-colors"
        >
          Get started
        </a>
      </div>
    </section>
  </div>
</Base>
