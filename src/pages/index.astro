---
const title = 'FindABACare - Find places and moments that work for your child';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white text-gray-900">
    <div class="max-w-6xl mx-auto p-8">
      <h1 class="text-4xl font-bold mb-4">FindABACare</h1>
      <p class="text-xl text-gray-700 mb-8">
        Find places and moments that work for your child
      </p>
      <p class="text-gray-600 mb-6">
        Quiet hours, visual guides, and small-group meetups verified by local parents.
      </p>
      <div class="grid sm:grid-cols-2 gap-4 max-w-2xl">
        <a
          href="/dallas"
          class="p-6 border border-gray-200 rounded-xl hover:border-gray-400 hover:shadow-lg transition-all"
        >
          <span class="text-lg font-semibold">Dallas, TX →</span>
        </a>
        <a
          href="/houston"
          class="p-6 border border-gray-200 rounded-xl hover:border-gray-400 hover:shadow-lg transition-all"
        >
          <span class="text-lg font-semibold">Houston, TX →</span>
        </a>
      </div>
      <div class="mt-12 p-6 bg-gray-50 rounded-lg">
        <h2 class="text-lg font-semibold mb-2">Project Status</h2>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>✅ Astro project initialized</li>
          <li>✅ Tailwind CSS configured</li>
          <li>✅ Core dependencies installed</li>
          <li>⏳ Supabase integration pending</li>
          <li>⏳ Database schema pending</li>
        </ul>
      </div>
    </div>
  </body>
</html>
