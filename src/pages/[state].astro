---
import Base from '../layouts/Base.astro';
import { getServerClient } from '../lib/supabaseServer';

const { state } = Astro.params;

// Validate state abbreviation
const validStates = ['tx', 'ca', 'ny', 'fl'];
if (!validStates.includes(state?.toLowerCase() || '')) {
  return Astro.redirect('/');
}

const stateUpper = state!.toUpperCase();

// State names map
const stateNames: Record<string, string> = {
  'TX': 'Texas',
  'CA': 'California',
  'NY': 'New York',
  'FL': 'Florida'
};

const stateName = stateNames[stateUpper];

// Get Supabase client
const supabase = getServerClient(Astro.request);

// Fetch all cities in this state
const { data: cities = [] } = await supabase
  .from('cities')
  .select('*, venue_count:venues(count)')
  .eq('state', stateUpper)
  .eq('status', 'active')
  .order('name');

// Process cities to get venue counts
const citiesWithCounts = cities.map(city => ({
  ...city,
  venueCount: city.venue_count?.[0]?.count || 0
}));

const title = `${stateName} Autism-Friendly Venues | findABA.care`;
const description = `Find autism-friendly venues and events across ${stateName}. Parent-verified places in ${citiesWithCounts.map(c => c.name).join(', ')}.`;
---

<Base title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-sm text-gray-600 mb-6">
      <a href="/" class="hover:text-gray-900">Home</a>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-gray-900">{stateName}</span>
    </div>

    <!-- Header -->
    <div class="mb-12">
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">
        Autism-Friendly Venues in {stateName}
      </h1>
      <p class="text-xl text-gray-600">
        Discover sensory-friendly places across {citiesWithCounts.length} {citiesWithCounts.length === 1 ? 'city' : 'cities'} in {stateName}
      </p>
    </div>

    <!-- Cities Grid -->
    {citiesWithCounts.length === 0 ? (
      <div class="text-center py-16 bg-gray-50 rounded-lg">
        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Coming Soon</h3>
        <p class="text-gray-600">We're working on adding cities in {stateName}. Check back soon!</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {citiesWithCounts.map((city) => (
          <a
            href={`/${state}/${city.slug}`}
            class="group bg-white border border-gray-200 rounded-xl p-6 hover:border-blue-500 hover:shadow-lg transition-all"
          >
            <div class="flex items-start justify-between mb-4">
              <div>
                <h2 class="text-2xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors">
                  {city.name}
                </h2>
                <p class="text-sm text-gray-500 mt-1">{stateName}</p>
              </div>
              <svg class="w-6 h-6 text-gray-400 group-hover:text-blue-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>

            <div class="space-y-3">
              <div class="flex items-center gap-2 text-gray-600">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                <span class="text-sm">
                  {city.venueCount} {city.venueCount === 1 ? 'venue' : 'venues'}
                </span>
              </div>

              {city.center_lat && city.center_lng && (
                <div class="flex items-center gap-2 text-gray-600">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span class="text-sm">View on map</span>
                </div>
              )}
            </div>

            <div class="mt-4 pt-4 border-t border-gray-200">
              <span class="text-sm font-medium text-blue-600 group-hover:text-blue-700">
                Explore {city.name} →
              </span>
            </div>
          </a>
        ))}
      </div>
    )}

    <!-- State Info Section -->
    <div class="mt-16 bg-gradient-to-r from-blue-50 to-purple-50 rounded-2xl p-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">About findABA.care in {stateName}</h2>
      <div class="prose prose-lg max-w-none">
        <p class="text-gray-700 leading-relaxed">
          findABA.care helps families across {stateName} find autism-friendly venues, events, and activities.
          Our platform features parent-verified information about sensory hours, quiet spaces, and accommodations
          to make every outing more predictable and enjoyable.
        </p>
      </div>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white/80 rounded-lg p-4">
          <div class="text-2xl font-bold text-blue-600 mb-1">
            {citiesWithCounts.reduce((sum, city) => sum + city.venueCount, 0)}
          </div>
          <div class="text-sm text-gray-600">Total Venues</div>
        </div>
        <div class="bg-white/80 rounded-lg p-4">
          <div class="text-2xl font-bold text-purple-600 mb-1">
            {citiesWithCounts.length}
          </div>
          <div class="text-sm text-gray-600">{citiesWithCounts.length === 1 ? 'City' : 'Cities'}</div>
        </div>
        <div class="bg-white/80 rounded-lg p-4">
          <div class="text-2xl font-bold text-green-600 mb-1">100%</div>
          <div class="text-sm text-gray-600">Parent-Verified</div>
        </div>
      </div>
    </div>
  </div>
</Base>
