---
import Base from '../layouts/Base.astro';
import { getServerClient, requireAuth } from '../lib/supabaseServer';

// Require authentication
let user;
try {
  user = await requireAuth(Astro.request);
} catch (error) {
  // If authentication failed, redirect to home page
  return Astro.redirect('/?error=auth-required');
}

const supabase = getServerClient(Astro.request);

// Get user profile
const { data: profile, error: profileError } = await supabase
  .from('profiles')
  .select('*, city:cities(id, name, state)')
  .eq('id', user.id)
  .single();

// Handle profile query errors
if (profileError) {
  console.error('Profile query error - Full error object:', profileError);
  console.error('Profile query error - Stringified:', JSON.stringify(profileError));
  console.error('Profile query error - Details:', {
    message: profileError.message,
    details: profileError.details,
    hint: profileError.hint,
    code: profileError.code,
    type: typeof profileError,
    keys: Object.keys(profileError)
  });

  const errorMessage = profileError.message || profileError.details || profileError.hint || 'Unknown database error';
  throw new Error(`Failed to load profile: ${errorMessage}`);
}

// If no profile, redirect to onboarding
if (!profile) {
  return Astro.redirect('/onboarding');
}

// Get cities for dropdown
const { data: cities } = await supabase
  .from('cities')
  .select('id, name, state')
  .order('name');

const title = 'My Profile | autism.place';
const description = 'Manage your profile and preferences';
---

<Base title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-2">My Profile</h1>
      <p class="text-gray-600">Manage your information and preferences</p>
    </div>

    <!-- Profile Form -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-8">
      <form id="profile-form" class="space-y-6">
        <!-- Avatar Upload -->
        <div>
          <label class="block text-sm font-medium text-gray-900 mb-3">
            Profile Photo
          </label>
          <div class="flex items-center gap-6">
            <div class="w-24 h-24 rounded-full bg-gray-200 flex items-center justify-center overflow-hidden">
              {profile.avatar_url ? (
                <img src={profile.avatar_url} alt="Profile" class="w-full h-full object-cover" id="avatar-preview" />
              ) : (
                <svg class="w-12 h-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="avatar-placeholder">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              )}
            </div>
            <div>
              <input
                type="file"
                accept="image/*"
                id="avatar-input"
                class="hidden"
              />
              <label
                for="avatar-input"
                class="cursor-pointer inline-block bg-gray-100 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-200 transition-colors"
              >
                Choose Photo
              </label>
              <p class="text-xs text-gray-500 mt-2">Max 2MB, JPG or PNG</p>
            </div>
          </div>
        </div>

        <!-- First Name -->
        <div>
          <label for="first_name" class="block text-sm font-medium text-gray-900 mb-2">
            First Name *
          </label>
          <input
            type="text"
            id="first_name"
            name="first_name"
            required
            value={profile.first_name || ''}
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <!-- Last Name -->
        <div>
          <label for="last_name" class="block text-sm font-medium text-gray-900 mb-2">
            Last Name *
          </label>
          <input
            type="text"
            id="last_name"
            name="last_name"
            required
            value={profile.last_name || ''}
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          <p class="mt-1 text-sm text-gray-500">Your last name will only show as an initial on public reviews</p>
        </div>

        <!-- Display Name (Auto-generated, read-only) -->
        <div>
          <label for="display_name" class="block text-sm font-medium text-gray-900 mb-2">
            Display Name (Public)
          </label>
          <input
            type="text"
            id="display_name"
            value={profile.display_name || ''}
            disabled
            class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-500 cursor-not-allowed"
          />
          <p class="mt-1 text-sm text-gray-500">Auto-generated from your first and last name</p>
        </div>

        <!-- Email (Read-only) -->
        <div>
          <label for="email" class="block text-sm font-medium text-gray-900 mb-2">
            Email
          </label>
          <input
            type="email"
            id="email"
            value={user.email}
            disabled
            class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-500 cursor-not-allowed"
          />
          <p class="mt-1 text-sm text-gray-500">Email cannot be changed</p>
        </div>

        <!-- City Selection -->
        <div>
          <label for="city_id" class="block text-sm font-medium text-gray-900 mb-2">
            City *
          </label>
          <select
            id="city_id"
            name="city_id"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">Select your city</option>
            {cities?.map((city) => (
              <option value={city.id} selected={city.id === profile.city_id}>
                {city.name}, {city.state}
              </option>
            ))}
          </select>
        </div>

        <!-- Child Age Band -->
        <div>
          <label for="child_age_band" class="block text-sm font-medium text-gray-900 mb-2">
            Child's Age Range
          </label>
          <select
            id="child_age_band"
            name="child_age_band"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">Prefer not to say</option>
            {['2-4', '5-7', '8-10', '11-13', '14+'].map((range) => (
              <option value={range} selected={range === profile.child_age_band}>
                {range} years{range === '14+' ? '' : ''}
              </option>
            ))}
          </select>
        </div>

        <!-- Interests -->
        <div>
          <label class="block text-sm font-medium text-gray-900 mb-3">
            Interests
          </label>
          <div class="grid grid-cols-2 gap-3">
            {['Animals', 'Art', 'Books', 'Building', 'Music', 'Nature', 'Science', 'Sports', 'Technology', 'Water play'].map((interest) => (
              <label class="flex items-center p-3 border border-gray-300 rounded-lg hover:bg-gray-50 cursor-pointer">
                <input
                  type="checkbox"
                  name="interests"
                  value={interest.toLowerCase()}
                  checked={profile.interests?.includes(interest.toLowerCase())}
                  class="rounded border-gray-300 text-blue-600 focus:ring-blue-500 mr-3"
                />
                <span class="text-sm text-gray-700">{interest}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Sensory Preferences -->
        <div>
          <label class="block text-sm font-medium text-gray-900 mb-3">
            Sensory Sensitivities
          </label>
          <div class="space-y-2">
            {[
              { key: 'hand_dryer', label: 'Sensitive to hand dryers' },
              { key: 'loud_noise', label: 'Sensitive to loud noises' },
              { key: 'bright_lights', label: 'Sensitive to bright/fluorescent lights' },
              { key: 'crowds', label: 'Prefers smaller groups' },
            ].map(({ key, label }) => (
              <label class="flex items-center p-3 border border-gray-300 rounded-lg hover:bg-gray-50 cursor-pointer">
                <input
                  type="checkbox"
                  name={key}
                  checked={profile.sensory_flags?.[key] === true}
                  class="rounded border-gray-300 text-blue-600 focus:ring-blue-500 mr-3"
                />
                <span class="text-sm text-gray-700">{label}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex gap-4 pt-4">
          <button
            type="submit"
            id="save-btn"
            class="flex-1 px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all disabled:bg-gray-400 disabled:cursor-not-allowed"
          >
            Save Changes
          </button>
          <a
            href="/"
            class="px-6 py-3 border border-gray-300 text-gray-700 font-semibold rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-all text-center"
          >
            Cancel
          </a>
        </div>

        <div id="success-message" class="hidden p-4 rounded-lg bg-green-50 border border-green-200 text-green-800"></div>
        <div id="error-message" class="hidden p-4 rounded-lg bg-red-50 border border-red-200 text-red-800"></div>
      </form>
    </div>

    <!-- Quick Links -->
    <div class="mt-8 bg-white rounded-xl shadow-lg border border-gray-200 p-8">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Quick Links</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a
          href="/profile/favorites"
          class="flex items-center gap-3 p-4 border border-gray-200 rounded-lg hover:border-red-300 hover:bg-red-50 transition-all group"
        >
          <svg class="w-6 h-6 text-red-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
          </svg>
          <div class="flex-1">
            <p class="font-medium text-gray-900 group-hover:text-red-700">My Favorites</p>
            <p class="text-sm text-gray-600">View saved venues</p>
          </div>
          <svg class="w-5 h-5 text-gray-400 group-hover:text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="/cities"
          class="flex items-center gap-3 p-4 border border-gray-200 rounded-lg hover:border-purple-300 hover:bg-purple-50 transition-all group"
        >
          <svg class="w-6 h-6 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          </svg>
          <div class="flex-1">
            <p class="font-medium text-gray-900 group-hover:text-purple-700">Explore Venues</p>
            <p class="text-sm text-gray-600">Find new places</p>
          </div>
          <svg class="w-5 h-5 text-gray-400 group-hover:text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Account Actions -->
    <div class="mt-8 bg-white rounded-xl shadow-lg border border-gray-200 p-8">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Account</h2>
      <div class="space-y-4">
        <div class="flex items-center justify-between pb-4 border-b border-gray-200">
          <div>
            <p class="font-medium text-gray-900">Joined</p>
            <p class="text-sm text-gray-600">{new Date(profile.created_at).toLocaleDateString()}</p>
          </div>
        </div>
        <div class="flex items-center justify-between">
          <div>
            <p class="font-medium text-gray-900">Account Role</p>
            <p class="text-sm text-gray-600 capitalize">{profile.role}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { createClient } from '@supabase/supabase-js';

    // Initialize Supabase client (only needed for avatar upload)
    const supabase = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );

    const form = document.getElementById('profile-form') as HTMLFormElement;
    const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
    const successDiv = document.getElementById('success-message') as HTMLDivElement;
    const errorDiv = document.getElementById('error-message') as HTMLDivElement;
    const avatarInput = document.getElementById('avatar-input') as HTMLInputElement;
    const avatarPreview = document.getElementById('avatar-preview') as HTMLImageElement;
    const avatarPlaceholder = document.getElementById('avatar-placeholder') as SVGElement;

    let uploadedAvatarFile: File | null = null;

    // Handle avatar file selection
    avatarInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) {
        // Validate file type and size
        if (!file.type.startsWith('image/')) {
          alert('Please select an image file');
          return;
        }

        if (file.size > 2 * 1024 * 1024) { // 2MB limit
          alert('Image must be less than 2MB');
          return;
        }

        uploadedAvatarFile = file;

        // Create preview
        const reader = new FileReader();
        reader.onloadend = () => {
          const previewUrl = reader.result as string;

          // Show preview image
          if (avatarPreview) {
            avatarPreview.src = previewUrl;
            avatarPreview.style.display = 'block';
          } else {
            // Create new preview image
            const div = avatarPlaceholder?.parentElement;
            if (div) {
              const img = document.createElement('img');
              img.id = 'avatar-preview';
              img.src = previewUrl;
              img.alt = 'Profile';
              img.className = 'w-full h-full object-cover';
              div.innerHTML = '';
              div.appendChild(img);
            }
          }
        };
        reader.readAsDataURL(file);
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';
      successDiv.classList.add('hidden');
      errorDiv.classList.add('hidden');

      try {
        const formData = new FormData(form);

        // Collect interests
        const interests = Array.from(formData.getAll('interests')) as string[];

        // Build sensory flags
        const sensoryFlags: Record<string, boolean> = {
          hand_dryer: formData.has('hand_dryer'),
          loud_noise: formData.has('loud_noise'),
          bright_lights: formData.has('bright_lights'),
          crowds: formData.has('crowds'),
        };

        const firstName = formData.get('first_name') as string;
        const lastName = formData.get('last_name') as string;

        let avatarUrl = null;

        // Upload avatar if a new one was selected
        if (uploadedAvatarFile) {
          // Get current user ID for avatar upload
          const { data: { user } } = await supabase.auth.getUser();
          if (!user) throw new Error('Not authenticated');

          const fileExt = uploadedAvatarFile.name.split('.').pop();
          const fileName = `${user.id}/${Date.now()}.${fileExt}`;

          const { error: uploadError } = await supabase.storage
            .from('avatars')
            .upload(fileName, uploadedAvatarFile, {
              cacheControl: '3600',
              upsert: true
            });

          if (uploadError) throw uploadError;

          // Get public URL
          const { data } = supabase.storage
            .from('avatars')
            .getPublicUrl(fileName);

          avatarUrl = data.publicUrl;
        }

        // Build update object for API
        const updateData: any = {
          first_name: firstName.trim(),
          last_name: lastName.trim(),
          city_id: formData.get('city_id') as string || null,
          child_age_band: formData.get('child_age_band') as string || null,
          interests: interests.length > 0 ? interests : null,
          sensory_flags: sensoryFlags,
        };

        // Only include avatar if new one was uploaded
        if (avatarUrl) {
          updateData.avatar_url = avatarUrl;
        }

        // Call API endpoint to update profile
        const response = await fetch('/api/profile', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(updateData),
          credentials: 'include', // Include cookies for authentication
        });

        if (!response.ok) {
          const errorData = await response.json();
          throw new Error(errorData.error || 'Failed to update profile');
        }

        const { profile } = await response.json();

        // Update display name field to show new value
        const displayNameInput = document.getElementById('display_name') as HTMLInputElement;
        if (displayNameInput && profile.display_name) {
          displayNameInput.value = profile.display_name;
        }

        // Show success message
        successDiv.textContent = '✅ Profile updated successfully!';
        successDiv.classList.remove('hidden');

        // Clear uploaded file
        uploadedAvatarFile = null;

        // Auto-hide after 3 seconds
        setTimeout(() => {
          successDiv.classList.add('hidden');
        }, 3000);
      } catch (error: any) {
        console.error('Error updating profile:', error);
        errorDiv.textContent = error.message || 'Failed to update profile. Please try again.';
        errorDiv.classList.remove('hidden');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Changes';
      }
    });
  </script>
</Base>
