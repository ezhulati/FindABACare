---
import Base from '../layouts/Base.astro';
import { getServerClient, requireAuth } from '../lib/supabaseServer';

// Require authentication
const user = await requireAuth(Astro.request);

const supabase = getServerClient(Astro.request);

// Get user profile
const { data: profile } = await supabase
  .from('profiles')
  .select('*, city:cities(name, state)')
  .eq('auth_user', user.id)
  .single();

// If no profile, redirect to onboarding
if (!profile) {
  return Astro.redirect('/onboarding');
}

// Get cities for dropdown
const { data: cities } = await supabase
  .from('cities')
  .select('id, name, state')
  .order('name');

const title = 'My Profile | autism.place';
const description = 'Manage your profile and preferences';
---

<Base title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-2">My Profile</h1>
      <p class="text-gray-600">Manage your information and preferences</p>
    </div>

    <!-- Profile Form -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-8">
      <form id="profile-form" class="space-y-6">
        <!-- Display Name -->
        <div>
          <label for="display_name" class="block text-sm font-medium text-gray-900 mb-2">
            Display Name *
          </label>
          <input
            type="text"
            id="display_name"
            name="display_name"
            required
            value={profile.display_name || ''}
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <!-- Email (Read-only) -->
        <div>
          <label for="email" class="block text-sm font-medium text-gray-900 mb-2">
            Email
          </label>
          <input
            type="email"
            id="email"
            value={user.email}
            disabled
            class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-500 cursor-not-allowed"
          />
          <p class="mt-1 text-sm text-gray-500">Email cannot be changed</p>
        </div>

        <!-- City Selection -->
        <div>
          <label for="city_id" class="block text-sm font-medium text-gray-900 mb-2">
            City *
          </label>
          <select
            id="city_id"
            name="city_id"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">Select your city</option>
            {cities?.map((city) => (
              <option value={city.id} selected={city.id === profile.city_id}>
                {city.name}, {city.state}
              </option>
            ))}
          </select>
        </div>

        <!-- Child Age Band -->
        <div>
          <label for="child_age_band" class="block text-sm font-medium text-gray-900 mb-2">
            Child's Age Range
          </label>
          <select
            id="child_age_band"
            name="child_age_band"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">Prefer not to say</option>
            {['2-4', '5-7', '8-10', '11-13', '14+'].map((range) => (
              <option value={range} selected={range === profile.child_age_band}>
                {range} years{range === '14+' ? '' : ''}
              </option>
            ))}
          </select>
        </div>

        <!-- Interests -->
        <div>
          <label class="block text-sm font-medium text-gray-900 mb-3">
            Interests
          </label>
          <div class="grid grid-cols-2 gap-3">
            {['Animals', 'Art', 'Books', 'Building', 'Music', 'Nature', 'Science', 'Sports', 'Technology', 'Water play'].map((interest) => (
              <label class="flex items-center p-3 border border-gray-300 rounded-lg hover:bg-gray-50 cursor-pointer">
                <input
                  type="checkbox"
                  name="interests"
                  value={interest.toLowerCase()}
                  checked={profile.interests?.includes(interest.toLowerCase())}
                  class="rounded border-gray-300 text-blue-600 focus:ring-blue-500 mr-3"
                />
                <span class="text-sm text-gray-700">{interest}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Sensory Preferences -->
        <div>
          <label class="block text-sm font-medium text-gray-900 mb-3">
            Sensory Sensitivities
          </label>
          <div class="space-y-2">
            {[
              { key: 'hand_dryer', label: 'Sensitive to hand dryers' },
              { key: 'loud_noise', label: 'Sensitive to loud noises' },
              { key: 'bright_lights', label: 'Sensitive to bright/fluorescent lights' },
              { key: 'crowds', label: 'Prefers smaller groups' },
            ].map(({ key, label }) => (
              <label class="flex items-center p-3 border border-gray-300 rounded-lg hover:bg-gray-50 cursor-pointer">
                <input
                  type="checkbox"
                  name={key}
                  checked={profile.sensory_flags?.[key] === true}
                  class="rounded border-gray-300 text-blue-600 focus:ring-blue-500 mr-3"
                />
                <span class="text-sm text-gray-700">{label}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex gap-4 pt-4">
          <button
            type="submit"
            id="save-btn"
            class="flex-1 px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all disabled:bg-gray-400 disabled:cursor-not-allowed"
          >
            Save Changes
          </button>
          <a
            href="/"
            class="px-6 py-3 border border-gray-300 text-gray-700 font-semibold rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-all text-center"
          >
            Cancel
          </a>
        </div>

        <div id="success-message" class="hidden p-4 rounded-lg bg-green-50 border border-green-200 text-green-800"></div>
        <div id="error-message" class="hidden p-4 rounded-lg bg-red-50 border border-red-200 text-red-800"></div>
      </form>
    </div>

    <!-- Account Actions -->
    <div class="mt-8 bg-white rounded-xl shadow-lg border border-gray-200 p-8">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Account</h2>
      <div class="space-y-4">
        <div class="flex items-center justify-between pb-4 border-b border-gray-200">
          <div>
            <p class="font-medium text-gray-900">Joined</p>
            <p class="text-sm text-gray-600">{new Date(profile.created_at).toLocaleDateString()}</p>
          </div>
        </div>
        <div class="flex items-center justify-between">
          <div>
            <p class="font-medium text-gray-900">Account Role</p>
            <p class="text-sm text-gray-600 capitalize">{profile.role}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const supabase = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );

    const form = document.getElementById('profile-form') as HTMLFormElement;
    const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
    const successDiv = document.getElementById('success-message') as HTMLDivElement;
    const errorDiv = document.getElementById('error-message') as HTMLDivElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';
      successDiv.classList.add('hidden');
      errorDiv.classList.add('hidden');

      try {
        const formData = new FormData(form);

        // Collect interests
        const interests = Array.from(formData.getAll('interests')) as string[];

        // Build sensory flags
        const sensoryFlags: Record<string, boolean> = {
          hand_dryer: formData.has('hand_dryer'),
          loud_noise: formData.has('loud_noise'),
          bright_lights: formData.has('bright_lights'),
          crowds: formData.has('crowds'),
        };

        // Get current user
        const { data: { user } } = await supabase.auth.getUser();
        if (!user) throw new Error('Not authenticated');

        // Update profile
        const { error } = await supabase
          .from('profiles')
          .update({
            display_name: formData.get('display_name') as string,
            city_id: formData.get('city_id') as string || null,
            child_age_band: formData.get('child_age_band') as string || null,
            interests: interests.length > 0 ? interests : null,
            sensory_flags: sensoryFlags,
          })
          .eq('auth_user', user.id);

        if (error) throw error;

        // Show success message
        successDiv.textContent = '✅ Profile updated successfully!';
        successDiv.classList.remove('hidden');

        // Auto-hide after 3 seconds
        setTimeout(() => {
          successDiv.classList.add('hidden');
        }, 3000);
      } catch (error: any) {
        console.error('Error updating profile:', error);
        errorDiv.textContent = error.message || 'Failed to update profile. Please try again.';
        errorDiv.classList.remove('hidden');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Changes';
      }
    });
  </script>
</Base>
